---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import BlogPost from "../../components/BlogPost.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (e) => e.data.locale === "de");
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props;
---

<Base locale="de" path={`/blog/${post.data.slug}`} title={`${post.data.title} · Synapsio`} description={post.data.description}
  article={{ published: post.data.date instanceof Date ? post.data.date.toISOString() : String(post.data.date), section: post.data.category }}>
  <BlogPost locale="de" post={post} />
</Base>
