---
// Font-specimen page for the design gate. Dev-only: noindex, excluded from
// sitemap, removed before merge to main.
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource-variable/schibsted-grotesk";
import "@fontsource-variable/familjen-grotesk";
import "../../styles/global.css";

const specimens = [
  { name: "IBM Plex Sans", css: '"IBM Plex Sans Variable", sans-serif', note: "Aktueller Favorit: technische Herkunft, sehr gute Umlaute, ruhig." },
  { name: "Schibsted Grotesk", css: '"Schibsted Grotesk Variable", sans-serif', note: "Mehr Charakter in den Kurven, etwas wärmer, editorialer." },
  { name: "Familjen Grotesk", css: '"Familjen Grotesk Variable", sans-serif', note: "Kompakter und markanter, leicht eigenwillige Details." },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Schrift-Spezimen (intern)</title>
  </head>
  <body class="bg-ground text-fg">
    <div class="container-site py-14">
      <p class="label-quiet">Interne Seite · Schriftentscheidung für den Neubau</p>
      <h1 class="h2 mt-2">Drei Kandidaten, gleicher Inhalt. Welche fühlt sich nach Synapsio an?</h1>

      {
        specimens.map((s) => (
          <section class="hairline-t mt-12 pt-8" style={`font-family: ${s.css}`}>
            <p class="label-quiet" style="font-family: var(--font-sans)">
              {s.name} · {s.note}
            </p>
            <p class="display mt-4">Ihr Einkauf arbeitet jetzt auch nachts.</p>
            <p class="mt-4 max-w-2xl text-[1.05rem] text-fg-soft">
              Synapsio ist der KI-Mitarbeiter für den Einkauf im Mittelstand. Er schlägt
              Bestellungen vor, schreibt mit Ihren Lieferanten, prüft Rechnungen. Und er
              fragt Sie, bevor er Geld ausgibt.
            </p>
            <p class="mt-4 text-[0.9rem] text-fg-muted">
              ÄÖÜ äöü ß 0123456789 · Lieferzuverlässigkeit, Freigabeschwelle, Großhandel
            </p>
          </section>
        ))
      }
    </div>
  </body>
</html>
