---
// /blog — the index, built as the data tape.
//
// It was a stack of hairline rows before, which was correct as a layout and wrong as a page: it
// used the same device as every other section on the site, so the one surface meant for READING
// looked like another marketing block. Every page here that works is carried by an object of its
// own (the console hero, the app mock, the Horizonte world, the dome). This is the blog's.
//
// Design, motion and the structural traps are documented in FilmTape.astro; the styles are in
// src/styles/tape.css, shared with the prototype harness the variants were judged in.
import { getCollection } from "astro:content";
import { blogCopy } from "../i18n/blog";
import { localePath, CAL_URL, type Locale } from "../i18n/ui";
import SiteNav from "./SiteNav.astro";
import SiteFooter from "./SiteFooter.astro";
import FilmTape from "./FilmTape.astro";
import "../styles/tape.css";
// Serif for post titles only, body stays Schibsted. See FilmTape.astro for why Newsreader.
import "@fontsource-variable/newsreader";

interface Props { locale?: Locale }
const { locale = "de" } = Astro.props;
const c = blogCopy[locale];
const p = (path: string) => localePath(locale, path);

const posts = (await getCollection("blog", (e) => e.data.locale === locale)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// The tape wants presentation strings, not Dates: it groups by the month BAND and prints the day
// on its own. Both come from the reader's locale, so the German and English tapes band correctly
// ("Juli 2026" / "July 2026") without a second date table.
const intl = locale === "de" ? "de-DE" : "en-GB";
const records = posts.map((post) => ({
  day: String(post.data.date.getDate()),
  month: post.data.date.toLocaleDateString(intl, { month: "long", year: "numeric" }),
  tag: post.data.tag,
  rt: c.readingTime(post.data.readingTime),
  title: post.data.title,
  lede: post.data.description,
  href: p(`/blog/${post.data.slug}`),
}));
---

<SiteNav locale={locale} path="/blog" active="blog" />

<main>
  <section class="fm-page">
    <div class="shell fm-mast">
      <span class="fm-kicker">{c.kicker}</span>
      <h1>{c.mast}</h1>
      <p>{c.lede}</p>
    </div>

    {
      records.length === 0 ? (
        <div class="shell bl-empty-wrap"><p class="bl-empty">{c.empty}</p></div>
      ) : (
        <div class="fm-tape">
          <FilmTape posts={records} legend={c.traceLegend} />
        </div>
      )
    }
  </section>

  <section class="shell bl-close">
    <h2>{c.ctaH}</h2>
    <p>{c.ctaP}</p>
    <a class="btn lg primary" href={CAL_URL}>{c.cta}</a>
  </section>

  <SiteFooter locale={locale} />
</main>

<style>
  .bl-empty-wrap { padding-block: clamp(40px, 8vh, 90px); }
  .bl-empty { color: var(--fg-muted); padding: 40px 0; border-top: 1px solid var(--hairline); }

  .bl-close { padding-block: clamp(46px,7vh,86px) clamp(56px,8vh,100px); text-align: center; }
  .bl-close h2 { font-size: clamp(1.45rem,2.6vw,2rem); font-weight: 600; letter-spacing: -0.02em; }
  .bl-close p { margin: 14px auto 26px; max-width: 46ch; color: var(--fg-soft); }
</style>
