---
// /produkt, chapter "Die Beschaffung": a consolidation machine.
//
// WHY THIS OBJECT. The chapter's least obvious claim is that the agent does not trickle orders
// out: it pulls every open requirement for the same supplier into ONE order and holds it to the
// cut-off. Nothing else on the site draws that. Three chutes carrying single requirements go in
// at the back, one crate comes out at the front with all of them in it.
//
// A device appears once on this site: the startpage owns the ramp and the lorry, the network owns
// the warehouses, /ueber-uns owns the desk. This is a machine, and it is only here.
//
// MOTION CONTRACT: the object may animate, prose never does. One parcel travels down a chute and
// into the crate, once, on reveal. Reduced motion shows it already arrived.
import { Scene, type V3 } from "../lib/iso";

const S = new Scene();

// ---- the machine ------------------------------------------------------------------------------
const MX = 44, MY = 26, MW = 78, MD = 54, MH = 40;
S.bx(MX, MY, 0, MW, MD, MH);
// a lit status band on the face that looks at the viewer, so the machine reads as running
S.panelY(MX + 8, MX + MW - 8, 24, 31, MY + MD, "so-band", 0.5);
S.panelY(MX + 8, MX + 26, 25.2, 29.8, MY + MD + 0.1, "so-band hot", 0.9);
// a hopper mouth on top
S.bx(MX + 10, MY + 8, MH, MW - 20, MD - 18, 5);
S.pad(MX + 15, MY + 13, MH + 5.2, MW - 30, MD - 28, "so-mouth", 0.6);

// ---- three chutes in, at the BACK (small y) ----------------------------------------------------
// Each carries one open requirement. They enter the hopper from three directions so the drawing
// says "several things arriving", not "a conveyor".
const IN: { a: V3; b: V3; hot: boolean }[] = [
  { a: [28, -18, 74], b: [MX + 18, MY + 14, MH + 8], hot: false },
  { a: [74, -30, 82], b: [MX + 38, MY + 12, MH + 8], hot: true },
  { a: [120, -14, 70], b: [MX + 58, MY + 16, MH + 8], hot: false },
];
IN.forEach((c) => S.bar(c.a, c.b, 13, 2.4, "face"));
// a parcel resting partway down each chute
IN.forEach((c, i) => {
  const k = [0.34, 0.52, 0.4][i];
  const p: V3 = [
    c.a[0] + (c.b[0] - c.a[0]) * k,
    c.a[1] + (c.b[1] - c.a[1]) * k,
    c.a[2] + (c.b[2] - c.a[2]) * k + 4,
  ];
  S.bx(p[0] - 5, p[1] - 5, p[2], 10, 10, 8, c.hot ? "so-parcel hot" : "so-parcel", 2);
});

// ---- one chute out, at the FRONT (large y) -----------------------------------------------------
// ---- the crate: one order, everything in it -----------------------------------------------------
const CX = MX + MW / 2 - 12, CY = MY + MD + 34, CZ = 0;
// ⚠️ The chute has to STOP at the crate's back rim. Run past it and it comes out of the far side
// and the crate reads as something the chute happens to cross rather than as what it fills.
const OUT_A: V3 = [MX + MW / 2, MY + MD - 6, 17];
const OUT_B: V3 = [CX + 22, CY + 2, CZ + 18];
S.bar(OUT_A, OUT_B, 26, 2.6, "face");
S.tray(CX, CY, CZ, 44, 34, 16, "so-fill");
// the three requirements, now in one crate
S.bx(CX + 6, CY + 6, CZ + 4, 10, 10, 8, "so-parcel", 2);
S.bx(CX + 19, CY + 8, CZ + 4, 10, 10, 8, "so-parcel hot", 2);
S.bx(CX + 12, CY + 19, CZ + 4, 10, 10, 8, "so-parcel", 2);

const faces = S.draw();
const vb = S.viewBox(12);

// The travelling parcel: it slides down the middle chute and lands in the crate. Given as two
// screen points so the runtime only has to interpolate a translate, not rebuild geometry.
import { P2 } from "../lib/iso";
const travelFrom = P2([IN[1].a[0], IN[1].a[1], IN[1].a[2] + 4]);
const travelTo = P2([CX + 19, CY + 8, CZ + 4]);
const travelBox = (() => {
  const T = new Scene();
  T.bx(-5, -5, 0, 10, 10, 8, "so-parcel hot", 1);
  return T.draw();
})();
const travel = `${travelFrom[0].toFixed(1)},${travelFrom[1].toFixed(1)},${travelTo[0].toFixed(1)},${travelTo[1].toFixed(1)}`;
---

<figure class="iso so" data-iso data-travel={travel} aria-hidden="true">
  <svg viewBox={vb} role="presentation">
    {faces.map((f) => (<polygon class={f.cls} points={f.pts} />))}
    {/* the one parcel that moves; it starts at the top of the middle chute */}
    <g class="so-travel">
      {travelBox.map((f) => (<polygon class={f.cls} points={f.pts} />))}
    </g>
  </svg>
</figure>

<style>
  .iso { margin: 0; display: block; }
  .iso svg { width: 100%; height: auto; display: block; overflow: visible; }

  .so .so-band { fill: #12262f; stroke: var(--edge-soft); stroke-width: 1;
    vector-effect: non-scaling-stroke; }
  .so .so-band.hot { fill: var(--coral); stroke: none; }
  .so .so-mouth { fill: #08161c; stroke: var(--edge-soft); stroke-width: 1;
    vector-effect: non-scaling-stroke; }
  .so .so-parcel { fill: #24505f; stroke: var(--edge); stroke-width: 1;
    vector-effect: non-scaling-stroke; }
  .so .so-parcel.lit { fill: #2f647550; }
  .so .so-parcel.hot { fill: #7d5039; }
  .so .so-parcel.hot.lit { fill: var(--coral); }
  .so .so-fill { fill: #2f5f66; stroke: none; }

  /* Gated on html[data-js], every rule in the group carrying the prefix, or a no-JS render shows
     a parcel parked at the top of a chute for no reason. */
  :global(html[data-js]) .so .so-travel { opacity: 0; }
  :global(html[data-js]) .so.in .so-travel { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js]) .so .so-travel { opacity: 0; }
    :global(html[data-js]) .so.in .so-travel { opacity: 0; }
  }
</style>

<script is:inline>
  (function () {
    var els = document.querySelectorAll("[data-travel]");
    if (!els.length) return;
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function run(fig) {
      var g = fig.querySelector(".so-travel");
      var d = (fig.getAttribute("data-travel") || "").split(",").map(Number);
      if (!g || d.length < 4) return;
      if (reduced) return;                       // the crate already shows the parcel arrived
      var t0 = performance.now() + 320, DUR = 1100;
      (function step(now) {
        var k = Math.min(1, Math.max(0, (now - t0) / DUR));
        // ease-in-out: it starts by sliding and lands rather than braking, which is how a chute
        // behaves. The site's entrance curve is ease-out, but this is travel, not an entrance.
        var e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        var x = d[0] + (d[2] - d[0]) * e, y = d[1] + (d[3] - d[1]) * e;
        g.setAttribute("transform", "translate(" + x.toFixed(1) + "," + y.toFixed(1) + ")");
        g.style.opacity = k >= 1 ? "0" : "1";    // hand over to the parcel already in the crate
        if (k < 1) requestAnimationFrame(step);
      })(performance.now());
    }

    function fire(el) { el.classList.add("in"); run(el); }
    if (!("IntersectionObserver" in window)) { els.forEach(fire); return; }
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (en) {
        if (!en.isIntersecting) return;
        fire(en.target);
        io.unobserve(en.target);
      });
    }, { rootMargin: "0px 0px -15% 0px" });
    els.forEach(function (e) { io.observe(e); });
  })();
</script>
