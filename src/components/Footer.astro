---
import { t, localePath, APP_URL, CONTACT_EMAIL, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const cols = [
  {
    label: t(locale, "footer.product"),
    links: [
      { href: localePath(locale, "/produkt"), label: t(locale, "nav.product") },
      { href: localePath(locale, "/sicherheit"), label: t(locale, "nav.security") },
      { href: localePath(locale, "/pilot"), label: t(locale, "footer.pilot") },
      { href: APP_URL, label: t(locale, "footer.app"), external: true },
    ],
  },
  {
    label: t(locale, "footer.company"),
    links: [
      { href: localePath(locale, "/ueber-uns"), label: t(locale, "nav.about") },
      { href: localePath(locale, "/blog"), label: t(locale, "nav.blog") },
      { href: "/en/investors", label: t(locale, "footer.investors") },
      { href: `mailto:${CONTACT_EMAIL}`, label: t(locale, "footer.contact") },
    ],
  },
  {
    label: t(locale, "footer.legal"),
    links: [
      { href: localePath(locale, "/impressum"), label: t(locale, "footer.imprint") },
      { href: localePath(locale, "/datenschutz"), label: t(locale, "footer.privacy") },
      { href: localePath(locale, "/agb"), label: t(locale, "footer.terms") },
    ],
  },
];
---

<footer class="hairline-t mt-section">
  <div class="container-site py-14">
    <div class="flex flex-col gap-12 lg:flex-row lg:justify-between">
      <div class="max-w-xs">
        <div class="flex items-center gap-3">
          <img src="/synapsio-logo.png" alt="" class="h-8 w-auto" />
          <span class="text-[0.95rem] font-semibold tracking-[0.18em] uppercase">Synapsio</span>
        </div>
        <p class="mt-4 text-[0.92rem] text-fg-muted italic">{t(locale, "footer.motto")}</p>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        {
          cols.map((col) => (
            <div>
              <h2 class="label-quiet mb-4">{col.label}</h2>
              <ul class="space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-[0.9rem] text-fg-soft hover:text-fg transition-colors duration-150"
                      {...("external" in link && link.external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="hairline-t mt-12 pt-6">
      <p class="text-[0.8rem] text-fg-muted">{t(locale, "footer.legalline")}</p>
    </div>
  </div>
</footer>
