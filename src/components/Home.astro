      <span class="mono-num">{content.sections.scenes}</span>
    </div>
    <div class="mt-2 grid md:grid-cols-3 rule-grid">
      {
        content.scenes.map((s) => (
          <div class="pt-8 md:pt-10 pb-4">
            <p class="font-mono text-[1.9rem] leading-none text-fg-muted">{s.t}</p>
            <h3 class="h3 mt-5">{s.h}</h3>
            <p class="prose-site mt-3 text-[0.96rem]">{s.p}</p>
