                <div class="bt"><div class="bt-l">{c.ctrl.b3.t2l}</div><div class="bt-v">{c.ctrl.b3.t2v}</div><div class="bt-sub">{c.ctrl.b3.t2s}</div></div>
                <div class="bt wide"><div class="bt-row"><span class="bt-l">{c.ctrl.b3.t3l}</span><span class="bt-v sm">{c.ctrl.b3.t3v}</span></div><div class="bt-note">{c.ctrl.b3.t3n}</div></div>
