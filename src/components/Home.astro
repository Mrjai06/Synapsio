          </ol>
          <div class="mx-5 mb-4 mt-1 h-px bg-hairline">
            <div class="progress-fill h-px w-0 bg-teal-soft"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 01 · Scenes -->
