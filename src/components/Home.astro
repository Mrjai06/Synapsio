<!-- Copy for the inline scripts. A JSON island rather than define:vars: these scripts are
     is:inline and hand-written, and a parsed blob keeps the strings out of the code entirely. -->
<script is:inline type="application/json" id="synCopy" set:html={JSON.stringify({ ...c.js, figs: c.figs.items })}></script>

<script is:inline>
  var SYN=JSON.parse(document.getElementById("synCopy").textContent);
(function(){
  "use strict";
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function animateCounters(scope){ scope.querySelectorAll("[data-to]").forEach(function(el){ if(el._done)return; el._done=true;
    var to=parseFloat(el.getAttribute("data-to")),pre=el.getAttribute("data-prefix")||"",suf=el.getAttribute("data-suffix")||"";
    if(reduced){el.textContent=pre+to+suf;return;} var t0=performance.now();
    (function s(now){var k=Math.min(1,(now-t0)/900);el.textContent=pre+Math.round(to*(1-Math.pow(1-k,3)))+suf;if(k<1)requestAnimationFrame(s);})(t0); }); }

  /* inventory row action icons (cart · edit · refresh · trash) */
  var ACT='<span class="ra"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M12 11v6M9 14h6"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20h9M16.5 3.5a2 2 0 013 3L7 19l-4 1 1-4z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 4v5h5M20 20v-5h-5M20 9a8 8 0 00-14-3M4 15a8 8 0 0014 3"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></span>';
  document.querySelectorAll("td.ACT").forEach(function(td){ td.innerHTML=ACT; });

  /* tabs */
  var TABS=["dashboard","inventory","orders"];
  var tabEls={},panelEls={};
  document.querySelectorAll("a[data-tab]").forEach(function(a){tabEls[a.getAttribute("data-tab")]=a;});
  document.querySelectorAll(".panel").forEach(function(p){panelEls[p.getAttribute("data-panel")]=p;});
  var cur=0,lock=false;

  /* Ava gutter windows — content changes per tab */
  // Three distinct window styles per tab: a = Ava insight (chat), b = supplier email (mail), c = agent log (term)
  var GUT=SYN.gut;
  function fillAva(el,d){ if(!d){el.style.display="none";return;} el.style.display="";
    var h='<div class="gh"><span class="gorb"><canvas class="ava-orb-canvas" width="40" height="40"></canvas></span><span class="gnm">Ava</span><span class="gvb">'+d.vb+'</span></div><div class="gsub">'+d.sub+'</div>';
    d.rows.forEach(function(r){ h+=r[0]?('<div class="grow"><b>'+r[0]+'</b><span>'+r[1]+'</span></div>'):('<div class="grow"><span class="gd"></span><span>'+r[1]+'</span></div>'); });
    if(d.tag) h+='<span class="gtag"><span class="d"></span>'+d.tag+'</span>';
    el.innerHTML=h; }
  function fillMail(el,d){ if(!d){el.style.display="none";return;} el.style.display="";
    el.innerHTML='<div class="mh"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>'+SYN.inbox+'</div>'+
      '<div class="from">'+d.from+'</div><div class="subj">'+d.subj+'</div>'+
      '<span class="mbadge '+d.badge[0]+'">'+d.badge[1]+'</span>'; }
  function fillTerm(el,d){ if(!d){el.style.display="none";return;} el.style.display="";
    var h='<div class="th"><i></i><i></i><i></i>synapsio · agent</div>';
    d.lines.forEach(function(l){ h+='<div class="tl">'+(l[0]?('<span class="ts">'+l[0]+'</span>'):'<span class="ts">›</span>')+'<span'+(l[2]?' class="arr"':'')+'>'+l[1]+'</span></div>'; });
    h+='<div class="tl"><span class="cur">▍</span></div>'; el.innerHTML=h; }
  var gwinA=document.getElementById("gwinA"), gwinB=document.getElementById("gwinB"), gwinC=document.getElementById("gwinC");
  function setGut(name){ var g=GUT[name]; fillAva(gwinA,g&&g.a); fillMail(gwinB,g&&g.b); fillTerm(gwinC,g&&g.c); initOrbs(); }

  /* Ava nudge — page-specific, drops from the orb (real MVP behaviour) */
  var NUDGE=SYN.nudge;
  var nudgeEl=document.getElementById("avaNudge"), orbSlot=document.getElementById("orbSlot"), nudgeTimer=null, nudgeHide=null;
  function showNudge(name){ var n=NUDGE[name]; if(!n){nudgeEl.classList.remove("on");return;}
    nudgeEl.className="ava-nudge "+n.cls;
    nudgeEl.innerHTML='<div class="lbl">'+n.lbl+'</div><div class="bd">'+n.bd+'</div><div class="act">'+n.act+'</div>';
    void nudgeEl.offsetWidth; nudgeEl.classList.add("on");
    clearTimeout(nudgeHide); nudgeHide=setTimeout(function(){ nudgeEl.classList.remove("on"); }, reduced?99999:4200); }
  function setTab(name){ TABS.forEach(function(t){tabEls[t].classList.toggle("on",t===name);panelEls[t].classList.toggle("on",t===name);});
    setGut(name);
    nudgeEl.classList.remove("on"); clearTimeout(nudgeTimer); nudgeTimer=setTimeout(function(){showNudge(name);}, reduced?0:600); }
  document.querySelectorAll("a[data-tab]").forEach(function(a){a.addEventListener("click",function(){lock=true;cur=TABS.indexOf(a.getAttribute("data-tab"));setTab(TABS[cur]);});});

  requestAnimationFrame(function(){
    document.body.classList.add("go");
    if(reduced){animateCounters(document);showNudge("dashboard");return;}
    setTimeout(function(){animateCounters(document.getElementById("surface"));},720);
    setTimeout(function(){showNudge("dashboard");},1500);
    setInterval(function(){ if(lock)return; cur=(cur+1)%TABS.length; setTab(TABS[cur]); },5600);
  });

  var nav=document.getElementById("nav");
  var surfaceEl=document.getElementById("surface");
  function clamp(v){return v<0?0:v>1?1:v;}
  function heroScroll(){
    nav.classList.toggle("stuck",window.scrollY>8);
    if(reduced){ surfaceEl.style.transform="scale(1)"; gwinA.style.opacity=1; gwinB.style.opacity=1; gwinC.style.opacity=1; return; }
    var r=surfaceEl.getBoundingClientRect(), vh=window.innerHeight;
    // p: 0 when the window first enters from the bottom, 1 once scrolled up into view
    var p=clamp((vh - r.top)/(vh*0.92));
    // pronounced Attio-style shrink: big on entry, settles smaller as side windows appear.
    // The 1.16 entry scale assumes gutter. Once the window is as wide as the viewport there is
    // none, and scaling up pushed it off the page edge, so cap the entry scale at what fits.
    var up=Math.min(1.16,(window.innerWidth-20)/surfaceEl.offsetWidth);
    if(up<0.96) up=0.96;
    surfaceEl.style.transform="scale("+(up-p*(up-0.96)).toFixed(3)+")";
    var g=clamp((p-0.34)/0.34);
    [gwinA,gwinB,gwinC].forEach(function(w,i){ w.style.opacity=g;
      var dir = (i===1)? -1 : 1;   // B on the right slides in from the right
      w.style.transform="translateX("+(dir*(1-g)*30).toFixed(1)+"px)"; });
  }
  window.addEventListener("scroll",heroScroll,{passive:true});
  window.addEventListener("resize",heroScroll,{passive:true});
  heroScroll();

  /* Ava orbs — dense firing sphere (teal core); shared render for main + gutter orbs */
  var ORB_N=118, ORB_PTS=[];
  for(var oi=0;oi<ORB_N;oi++){var oy2=1-(oi/(ORB_N-1))*2;var orr=Math.sqrt(Math.max(0,1-oy2*oy2));var oth=oi*2.399963;ORB_PTS.push({x:Math.cos(oth)*orr,y:oy2,z:Math.sin(oth)*orr,coral:oi%13===6,fire:Math.random()});}
  var orbList=[], orbT=0.3, orbDpr=Math.min(window.devicePixelRatio||1,2), orbLoop=false;
  function initOrbs(){
    var cs=[]; var main=document.getElementById("avaOrb"); if(main) cs.push(main);
    Array.prototype.forEach.call(document.querySelectorAll(".ava-orb-canvas"),function(c){cs.push(c);});
    orbList=cs.map(function(c){ if(c._orb) return c._orb; var ctx=c.getContext("2d"); if(!ctx) return null;
      var S=(parseInt(c.getAttribute("width"),10)||52)/2; c.width=S*orbDpr; c.height=S*orbDpr; ctx.scale(orbDpr,orbDpr); c._orb={ctx:ctx,S:S}; return c._orb; }).filter(Boolean);
    if(reduced){ renderOrbs(); return; }
    if(!orbLoop){ orbLoop=true; (function loop(){ orbT+=0.005; renderOrbs(); requestAnimationFrame(loop); })(); }
  }
  function renderOrbs(){ orbList.forEach(function(o){ var ctx=o.ctx,S=o.S,cx=S/2,cy=S/2,R=S/2-2,cs=Math.cos(orbT),sn=Math.sin(orbT); ctx.clearRect(0,0,S,S);
    var proj=ORB_PTS.map(function(p){var x=p.x*cs-p.z*sn,z=p.x*sn+p.z*cs;return{sx:cx+x*R,sy:cy+p.y*R,z:z,coral:p.coral,fire:p.fire};});
    proj.sort(function(a,b){return a.z-b.z;});
    proj.forEach(function(p){var d=(p.z+1)/2;var fl=(Math.sin(orbT*3+p.fire*30)>0.985)?1:0;ctx.beginPath();ctx.arc(p.sx,p.sy,0.5+d*(R*0.055)+fl*0.7,0,6.2832);ctx.fillStyle="rgba("+(p.coral?"232,132,90":"95,212,200")+","+(0.14+d*0.6+fl*0.3).toFixed(2)+")";ctx.fill();}); }); }
  initOrbs();
  setGut("dashboard");

  /* ===== isometric figures: Wahrnehmen · Produktion · Handeln · Lernen ===== */
  var SVGNS="http://www.w3.org/2000/svg",COS30=Math.cos(Math.PI/6),SIN30=0.5;
  function project(p){return[(p[0]-p[1])*COS30,(p[0]+p[1])*SIN30-p[2],p[0]+p[1]+p[2]];}
  function neg(a){return[-a[0],-a[1],-a[2]];}
  function box(o,u,v,w,ord,hot){function k(a,b,c){return[o[0]+a*u[0]+b*v[0]+c*w[0],o[1]+a*u[1]+b*v[1]+c*w[1],o[2]+a*u[2]+b*v[2]+c*w[2]];}
    var A=k(0,0,0),B=k(1,0,0),C=k(1,1,0),D=k(0,1,0),E=k(0,0,1),F=k(1,0,1),G=k(1,1,1),H=k(0,1,1);
    return[{pts:[A,B,C,D],nrm:neg(w),order:ord,hot:hot},{pts:[E,F,G,H],nrm:w,lit:true,order:ord,hot:hot},{pts:[A,B,F,E],nrm:neg(v),order:ord,hot:hot},{pts:[D,C,G,H],nrm:v,order:ord,hot:hot},{pts:[A,D,H,E],nrm:neg(u),order:ord,hot:hot},{pts:[B,C,G,F],nrm:u,order:ord,hot:hot}];}

  var FIGS=[
    {num:"FIG 01",label:SYN.figs[0].label,title:SYN.figs[0].title,text:SYN.figs[0].text,parts:7,rest:0.14,
      build:function(p){var f=[],n=7,W=18,H=23,th=0.40,zGap=0.62;
        for(var i=0;i<n;i++){var q=p[i],ang=q*(i-(n-1)/2)*0.038,ca=Math.cos(ang),sa=Math.sin(ang);
          var ox=q*i*5.6-W/2-8,oy=q*i*2.3-H/2-3,z=i*zGap,u=[W*ca,W*sa,0],v=[-H*sa,H*ca,0];
          f=f.concat(box([ox,oy,z],u,v,[0,0,th],i));
          var a=(q-0.40)/0.5;a=a<0?0:a>1?1:a;if(i===n-1)a=1;
          if(a>0.02){for(var L=0;L<4;L++){var fy=0.26+L*0.155,len=(L===0)?0.30:(L===3?0.34:0.56),zt=z+th+0.01;
            f.push({line:true,alpha:a*0.5,order:i+0.5,pts:[[ox+0.20*u[0]+fy*v[0],oy+0.20*u[1]+fy*v[1],zt],[ox+(0.20+len)*u[0]+fy*v[0],oy+(0.20+len)*u[1]+fy*v[1],zt]]});}}}
        return f;}},
    {num:"FIG 02",label:SYN.figs[1].label,title:SYN.figs[1].title,text:SYN.figs[1].text,parts:3,rest:0.0,
      build:function(p){ var f=[];   // warehouse rack: boxes on shelves, gaps where stock was drawn down, one box coral (knapp); hover picks several boxes off the shelf
        var cols=3, rows=3, sw=6.2, sh=5.0, sd=6.0, gx=1.3, gz=1.7;
        var pitchX=sw+gx, pitchZ=sh+gz, W=cols*pitchX-gx, Htot=rows*pitchZ-gz;
        var x0=-W/2, y0=-sd/2, yb=y0+sd;
        var occ=[[3,1,2],[1,0,3],[3,1,0]], si=0;   // bottom→top · 0 empty · 1 box · 2 coral(knapp) · 3 picked (slides out on hover, staggered)
        for(var r=0;r<rows;r++){ for(var c=0;c<cols;c++){ var o=occ[r][c]; if(!o) continue;
          var pad=1.4, slide=0; if(o===3){ slide=p[si]*7; si++; }
          f=f.concat(box([x0+c*pitchX+pad/2, y0+pad/2+slide, r*pitchZ+0.9],[sw-pad,0,0],[0,sd-pad,0],[0,0,sh-pad], r*cols+c+1, o===2)); } }
        function wire(a,b,al){ f.push({line:true,pts:[a,b],alpha:al===undefined?0.48:al,order:90}); }
        for(var c=0;c<=cols;c++){ var x=x0+c*pitchX-gx/2;
          wire([x,y0,0],[x,y0,Htot]); wire([x,yb,0],[x,yb,Htot],0.26); wire([x,y0,Htot],[x,yb,Htot],0.26); }
        for(var r=0;r<=rows;r++){ var z=(r===rows)?Htot:r*pitchZ-gz/2;
          wire([x0-gx/2,y0,z],[x0+W+gx/2,y0,z]); wire([x0-gx/2,yb,z],[x0+W+gx/2,yb,z],0.26); }
        return f;}},
    {num:"FIG 03",label:SYN.figs[2].label,title:SYN.figs[2].title,text:SYN.figs[2].text,parts:5,rest:0.3,
      build:function(p){ var f=[];   // conveyor: a line of parcels flows through (teal), one lifted off for you (coral)
        var beltL=42, beltD=8, beltH=1.4;
        f=f.concat(box([-beltL/2,-beltD/2,-beltH],[beltL,0,0],[0,beltD,0],[0,0,beltH], 0));
        for(var t=-beltL/2+3; t<beltL/2-2; t+=4){ f.push({line:true,pts:[[t,-beltD/2,0.02],[t,beltD/2,0.02]],alpha:0.20,order:1}); }
        var pw=5.0, pdp=5.0, ph=4.0;
        function parcel(cx,lift,ch,ord){
          f=f.concat(box([cx-pw/2,-pdp/2,lift],[pw,0,0],[0,pdp,0],[0,0,ph], ord, ch));
          var zt=lift+ph+0.02;
          f.push({line:true,pts:[[cx,-pdp/2,zt],[cx,pdp/2,zt]],alpha:0.5,order:ord+0.5,hot:ch});
          f.push({line:true,pts:[[cx-pw/2,0,zt],[cx+pw/2,0,zt]],alpha:0.32,order:ord+0.5,hot:ch}); }
        var flow=p[0]*6;   // the belt runs — the whole line of auto parcels advances together
        [-18,-11,-4,3].forEach(function(bx,k){ parcel(bx+flow, 0, false, 3+k); });
        parcel(15, 4.6 + p[4]*3.5, true, 9);   // one lifted off the belt (needs you)
        return f;}},
