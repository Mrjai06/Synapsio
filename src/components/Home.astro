---

<!-- Hero -->
<section class="container-site pt-20 pb-16 md:pt-28 md:pb-24">
  <div class="grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div>
      <h1 class="display">{content.heroH1}</h1>
      <p class="prose-site mt-6 text-[1.1rem]">{content.heroSub}</p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href={CAL_URL} class="btn-primary">{content.heroCta}</a>
        <a href={localePath(locale, "/produkt")} class="btn-secondary">{content.heroCta2}</a>
      </div>
    </div>

    <!-- Hero vignette: the one orchestrated moment of the page -->
    <div class="border border-hairline bg-surface p-6 md:p-8">
      <p class="label-quiet mb-5">Synapsio Agent · Live</p>
      <ol class="min-h-[13.5rem] space-y-4" data-vignette>
        {
          content.vignette.map((step, i) => (
            <li class="flex items-start gap-3 text-[0.95rem]">
              <span
                class:list={[
                  "mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full",
                  i === content.vignette.length - 1 ? "bg-teal-soft" : "bg-fg-muted",
                ]}
              />
              <span class={i === content.vignette.length - 1 ? "text-fg" : "text-fg-soft"}>
                {step}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  // Hero vignette loop: steps appear one by one, hold, restart.
  // Pauses off-screen; static when reduced motion is preferred.
  const vignettes = document.querySelectorAll<HTMLElement>("[data-vignette]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  vignettes.forEach((root) => {
    const steps = Array.from(root.querySelectorAll("li"));
    if (reduced || steps.length === 0) {
      root.classList.add("static");
      return;
    }
    let idx = 0;
    let timer: number | undefined;
    let running = false;

    const tick = () => {
      if (!running) return;
      if (idx < steps.length) {
        steps[idx]?.classList.add("on");
        idx += 1;
        timer = window.setTimeout(tick, idx === steps.length ? 2600 : 1150);
      } else {
        steps.forEach((s) => s.classList.remove("on"));
        idx = 0;
        timer = window.setTimeout(tick, 700);
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !running) {
            running = true;
            tick();
          } else if (!entry.isIntersecting && running) {
            running = false;
            if (timer) window.clearTimeout(timer);
          }
        }
      },
      { threshold: 0.3 },
    );
    io.observe(root);
  });

  // Scroll reveal: one-time fade-up for marked elements.
  const revealables = document.querySelectorAll(".reveal");
  if (revealables.length > 0) {
    const ro = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            ro.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    revealables.forEach((el) => ro.observe(el));
  }
</script>

<!-- Scenes -->
<section class="hairline-t">
  <div class="container-site py-16 md:py-24 reveal">
    <h2 class="h2">{content.scenesTitle}</h2>
