      var op=(r.op==null?1:r.op); if(el._o!==op){el.style.opacity=op;el._o=op;}
      el.setAttribute("d",r.d); el.style.display=""; }
    for(;i<pool.length;i++) pool[i].style.display="none";
  }

  if(reduced){ render(1); return; }
  var DUR=4700,start=0,raf=0,playing=false,finished=false;
  function tick(now){ if(!start)start=now; var t=(now-start)/DUR;
    if(t>=1){ render(1); finished=true; playing=false; raf=0; return; }
    render(t); raf=requestAnimationFrame(tick); }
  function play(){ if(raf)cancelAnimationFrame(raf); start=0; playing=true; finished=false; raf=requestAnimationFrame(tick); }
  render(0);
  var firstSeen=false;
  new IntersectionObserver(function(es){ es.forEach(function(e){
    if(e.isIntersecting){ if(!firstSeen){ firstSeen=true; play(); } else if(!playing && !finished){ play(); } }
    else if(raf){ cancelAnimationFrame(raf); raf=0; playing=false; }
  }); }, {threshold:0.4}).observe(tile);
  tile.addEventListener("pointerenter",function(){ play(); });
})();
</script>
