          {CONTACT_EMAIL}
        </a>
      </p>
    </div>
  </div>
</section>

<script>
  // Living console: highlight walks the always-visible rows, then restarts.
  const vignettes = document.querySelectorAll<HTMLElement>("[data-vignette]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  vignettes.forEach((root) => {
    const steps = Array.from(root.querySelectorAll<HTMLElement>(".step"));
    const bar = root.querySelector<HTMLElement>(".progress-fill");
    if (reduced || steps.length === 0) {
      root.classList.add("static");
      if (bar) bar.style.width = "100%";
      return;
    }

    let idx = -1;
    let timer: number | undefined;
    let running = false;

    const paint = () => {
      steps.forEach((s, i) => {
        s.classList.toggle("done", idx >= 0 && i < idx);
        s.classList.toggle("active", i === idx);
      });
      if (bar) bar.style.width = idx < 0 ? "0" : `${((idx + 1) / steps.length) * 100}%`;
    };

    const tick = () => {
      if (!running) return;
      idx += 1;
      if (idx >= steps.length) {
        idx = -1;
        paint();
        timer = window.setTimeout(tick, 900);
        return;
      }
      paint();
      timer = window.setTimeout(tick, idx === steps.length - 1 ? 3000 : 1500);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !running) {
            running = true;
            tick();
          } else if (!entry.isIntersecting && running) {
            running = false;
            if (timer) window.clearTimeout(timer);
          }
        }
      },
      { threshold: 0.3 },
    );
    io.observe(root);
  });

  // Scroll reveal
  const revealables = document.querySelectorAll(".reveal");
  if (revealables.length > 0) {
    const ro = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            ro.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    revealables.forEach((el) => ro.observe(el));
  }
</script>
