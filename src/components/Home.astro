    <p class="prose-site mx-auto mt-7 text-[1.14rem] leading-[1.6]">{content.heroSub}</p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href={CAL_URL} class="btn-primary">{content.heroCta}</a>
      <a href={localePath(locale, "/produkt")} class="btn-secondary">{content.heroCta2}</a>
    </div>
  </div>

  <!-- Living console: full-width product object -->
  <div class="container-site pb-20 md:pb-24">
    <div class="panel ticks mx-auto max-w-4xl" data-vignette>
      <div class="flex items-center justify-between border-b border-hairline-strong px-5 py-3.5">
        <div class="flex items-center gap-2.5">
          <span class="h-2 w-2 rounded-full bg-teal-soft"></span>
          <span class="text-[0.92rem] font-semibold tracking-tight">{content.vignetteTitle}</span>
        </div>
        <span class="mono-label">{content.vignetteLive}</span>
      </div>
      <div class="grid md:grid-cols-[220px_1fr]">
        <div class="hidden border-r border-hairline px-5 py-5 md:block">
          <p class="mono-label mb-4">{content.vignetteSideLabel}</p>
          <ul class="space-y-4">
            {
              content.vignetteSide.map((item) => (
                <li>
                  <span class="block font-mono text-[1.6rem] leading-none text-fg">{item.n}</span>
                  <span class="mt-1 block text-[0.8rem] text-fg-muted">{item.s}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <ol class="px-2 py-2">
            {
              content.vignette.map((step) => (
                <li class="step flex items-center gap-3.5 px-3 py-3">
                  <span class="dot h-2.5 w-2.5 shrink-0 rounded-full" />
                  <span class="mono-num w-11 shrink-0 !text-[0.7rem]">{step.t}</span>
                  <span class="text-[0.95rem] leading-snug">{step.s}</span>
                </li>
              ))
