---
import HorizonteIso from "./HorizonteIso.astro";
import NeuralSphere from "./NeuralSphere.astro";
import SiteNav from "./SiteNav.astro";
import SiteFooter from "./SiteFooter.astro";
import { homeCopy } from "../i18n/home";
import { localePath, CAL_URL, APP_URL, CONTACT_EMAIL, type Locale } from "../i18n/ui";

interface Props { locale?: Locale }
const { locale = "de" } = Astro.props;
const c = homeCopy[locale];
const p = (path: string) => localePath(locale, path);
---

<SiteNav locale={locale} path="/" />

<main>
  <div class="hero-sphere"><NeuralSphere /></div>

  <section class="hero shell">
    <span class="chip"><span class="sq"></span>{c.hero.chip}</span>
    <h1><span class="ln"><span>{c.hero.h1a}</span></span><span class="ln"><span><em>{c.hero.h1em}</em>{c.hero.h1b}</span></span></h1>
    <div class="hero-row">
      <p class="sub">{c.hero.sub}</p>
      <a class="hero-link" href={p("/produkt")}><span class="tag">{c.hero.linkTag}</span> {c.hero.link}</a>
    </div>

    <div class="stage-wrap">
      <div class="gwin a" id="gwinA"></div>
      <div class="gwin b mail" id="gwinB"></div>
      <div class="gwin c term" id="gwinC"></div>
      <div class="surface" id="surface">
        <div class="app">
          <aside class="side">
            <div class="logo">
              <span class="synapsio-mark" style="width:28px;height:28px"></span>
              <div><b>SYNAPSIO</b><small>{c.app.tagline}</small></div>
            </div>
            <nav class="snav">
              <div class="grp">
                <a data-tab="dashboard" class="on"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>{c.app.nav.dashboard}</a>
              </div>
              <div class="grp"><div class="glbl">{c.app.groups.ops}</div>
                <a data-tab="inventory"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 8l9-5 9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5"/></svg>{c.app.nav.inventory}</a>
                <a data-tab="orders"><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 12h6M9 16h4"/></svg>{c.app.nav.orders}</a>
                <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>{c.app.nav.approvals}<span class="badge">3</span></a>
                <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 2h8l6 6v8l-6 6H8l-6-6V8z"/><path d="M12 8v4M12 16v.5"/></svg>{c.app.nav.exceptions}</a>
              </div>
              <div class="grp"><div class="glbl">{c.app.groups.net}</div>
                <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/></svg>{c.app.nav.suppliers}</a>
                <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 9l1-5h16l1 5M4 9v10a1 1 0 001 1h14a1 1 0 001-1V9M4 9h16"/></svg>{c.app.nav.marketplace}</a>
                <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 7h13l5 5-5 5H3z"/><path d="M8 12H3"/></svg>{c.app.nav.supplierView}</a>
              </div>
              <div class="grp"><div class="glbl">{c.app.groups.intel}</div>
                <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 4a3 3 0 00-3 3 3 3 0 00-1 5.8A3 3 0 006 18a3 3 0 006 0V4zM15 4a3 3 0 013 3 3 3 0 011 5.8A3 3 0 0118 18a3 3 0 01-6 0V4z"/></svg>{c.app.nav.brain}</a>
                <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>{c.app.nav.intelligence}</a>
                <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 20V10M12 20V4M18 20v-7"/></svg>{c.app.nav.reports}</a>
              </div>
              <div class="grp"><div class="glbl">{c.app.groups.set}</div>
                <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="3"/><path d="M19.4 13a1.6 1.6 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.6 1.6 0 00-2.7 1.1V21a2 2 0 11-4 0v-.2a1.6 1.6 0 00-2.7-1.1l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.6 1.6 0 00-1.1-2.7H3a2 2 0 110-4h.2a1.6 1.6 0 001.1-2.7l-.1-.1a2 2 0 112.8-2.8l.1.1a1.6 1.6 0 001.8.3H10a1.6 1.6 0 001-1.5V3a2 2 0 114 0v.2a1.6 1.6 0 002.7 1.1l.1-.1a2 2 0 112.8 2.8l-.1.1a1.6 1.6 0 00-.3 1.8V10a1.6 1.6 0 001.5 1H21a2 2 0 110 4h-.2a1.6 1.6 0 00-1.4.9z"/></svg>{c.app.nav.settings}</a>
              </div>
              <div class="grp"><div class="glbl">{c.app.groups.admin}</div>
                <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>{c.app.nav.admin}</a>
              </div>
            </nav>
            <div class="sfoot">
              <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 9a6 6 0 1112 0c0 5 2 6 2 6H4s2-1 2-6z"/><path d="M10 20a2 2 0 004 0"/></svg>{c.app.notifications}<span class="badge">5</span></a>
              <div class="acct">jakob.ibrahim@synapsio.solutions</div>
              <a><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>{c.app.signout}</a>
            </div>
          </aside>

          <div class="main" id="main">
            <div class="apptop">
              <div class="orb-slot" id="orbSlot">
                <span class="orb-halo"></span>
                <canvas id="avaOrb" width="104" height="104"></canvas>
                <div class="ava-nudge" id="avaNudge"></div>
              </div>
              <span class="spacer"></span>
              <span class="beispiel">{c.app.sample}</span>
              <span class="langpill">DE <b>EN</b></span>
              <span class="toppill wk"><span class="sq"></span>{c.app.worker}</span>
              <span class="avatar"><span class="synapsio-mark" style="width:18px;height:18px"></span></span>
            </div>

            <!-- DASHBOARD -->
            <div class="panel on" data-panel="dashboard">
              <div class="pagehead"><h2>Dashboard</h2><span class="upd"><span class="d"></span>{c.app.updated}</span></div>
              <div class="autobar"><span class="sq"></span>{c.app.autobar}</div>
              <div class="needs">
                <h4>{c.app.needsTitle}</h4>
                {c.app.needs.map((nd, i) => (
                <div class="need"><span class="sq" style={"background:var(--" + (i === 0 ? "coral" : "amber") + ")"}></span><span class="t">{nd.t}<small>{nd.s}</small></span><span class="arw">→</span></div>))}
              </div>
              <div class="kpis">
                <div class="kpi coral"><div class="lbl">{c.app.kpis[0].lbl}</div><div class="r1"><div class="val" data-to="309" data-prefix="€ " data-suffix="K">€ 0K</div><span class="icbg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8l9-5 9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5"/></svg></span></div><div class="r2"><div class="sub">{c.app.kpis[0].sub}</div><svg class="spark" viewBox="0 0 64 22" preserveAspectRatio="none"><path d="M0 17 L10 15 L20 16 L30 11 L40 12 L52 7 L64 4" stroke="var(--teal-soft)"/></svg></div></div>
                <div class="kpi red"><div class="lbl">{c.app.kpis[1].lbl}</div><div class="r1"><div class="val" data-to="4">0</div><span class="icbg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l9 16H3z"/><path d="M12 9v4M12 16v.5"/></svg></span></div><div class="r2"><div class="sub">{c.app.kpis[1].sub}</div><svg class="spark" viewBox="0 0 64 22" preserveAspectRatio="none"><path d="M0 5 L10 7 L20 6 L30 10 L40 9 L52 15 L64 18" stroke="var(--red)"/></svg></div></div>
                <div class="kpi amber"><div class="lbl">{c.app.kpis[2].lbl}</div><div class="r1"><div class="val" data-to="9">0</div><span class="icbg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9a6 6 0 1112 0c0 5 2 6 2 6H4s2-1 2-6z"/><path d="M10 20a2 2 0 004 0"/></svg></span></div><div class="r2"><div class="sub">{c.app.kpis[2].sub}</div><svg class="spark" viewBox="0 0 64 22" preserveAspectRatio="none"><path d="M0 13 L10 12 L20 14 L30 9 L40 11 L52 7 L64 9" stroke="var(--amber)"/></svg></div></div>
                <div class="kpi teal"><div class="lbl">{c.app.kpis[3].lbl}</div><div class="r1"><div class="val" data-to="12">0</div><span class="icbg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 12h6M9 16h4"/></svg></span></div><div class="r2"><div class="sub">{c.app.kpis[3].sub}</div><svg class="spark" viewBox="0 0 64 22" preserveAspectRatio="none"><path d="M0 16 L10 14 L20 15 L30 10 L40 11 L52 8 L64 6" stroke="var(--teal-soft)"/></svg></div></div>
                <div class="kpi teal"><div class="lbl">{c.app.kpis[4].lbl}</div><div class="r1"><div class="val" data-to="24">0</div><span class="icbg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 2L4 14h6l-1 8 9-12h-6z"/></svg></span></div><div class="r2"><div class="sub">{c.app.kpis[4].sub}</div><svg class="spark" viewBox="0 0 64 22" preserveAspectRatio="none"><path d="M0 18 L10 16 L20 13 L30 13 L40 9 L52 8 L64 3" stroke="var(--teal-soft)"/></svg></div></div>
              </div>
              <div class="brainbar">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 4a3 3 0 00-3 3 3 3 0 00-1 5.8A3 3 0 006 18a3 3 0 006 0V4zM15 4a3 3 0 013 3 3 3 0 011 5.8A3 3 0 0118 18a3 3 0 01-6 0V4z"/></svg>
                <span class="lbl">{c.app.brain.lbl}</span>
                <span class="track"><span class="fill"></span></span><span class="pct">62%</span>
                <span class="meta">{c.app.brain.meta}</span>
              </div>
              <div class="impact">
                <div class="ih">{c.app.impact.h}</div><div class="ihs">{c.app.impact.s}</div>
                <div class="row">
                  <div class="cell"><div class="big" data-to="24">0</div><div class="cap">{c.app.impact.caps[0]}</div></div>
                  <div class="cell"><div class="big" data-to="57" data-prefix="€ " data-suffix="K">€ 0K</div><div class="cap">{c.app.impact.caps[1]}</div></div>
                  <div class="cell"><div class="big" data-to="18" data-prefix="~" data-suffix="h">~0h</div><div class="cap">{c.app.impact.caps[2]}</div></div>
                </div>
                <div class="wchart"><div class="wl">{c.app.impact.chart}</div><div class="bars"><i style="height:22%"></i><i style="height:38%"></i><i style="height:30%"></i><i style="height:52%"></i><i style="height:44%"></i><i style="height:66%"></i><i style="height:58%"></i><i class="last" style="height:82%"></i></div></div>
              </div>
            </div>

            <!-- INVENTORY -->
            <div class="panel" data-panel="inventory">
              <div class="pagehead"><h2>{c.app.nav.inventory}</h2><div class="ph-actions">{c.app.inv.actions.map((a, i) => (<span class={"ph-btn" + (i === 2 ? " primary" : "")}>{a}</span>))}</div></div>
              <div class="inv-toolbar">
                <span class="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>{c.app.inv.search}</span>
                <span class="drop">{c.app.inv.locations} <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></span>
              </div>
              <div class="filters">{c.app.inv.filters.map((f, i) => (<span class={"fpill" + (i === 0 ? " on" : "")}>{f}</span>))}</div>
              <div class="tbl-scroll"><table class="tbl">
                <thead><tr>{c.app.inv.head.map((h, i) => (<th class={i >= 2 && i <= 6 ? "r" : undefined}>{h}</th>))}<th></th></tr></thead>
                <tbody>
                  {c.app.inv.rows.map((r) => (
                  <tr><td class="name"><span class="sku">{r.sku}</span><span class="pn">{r.pn}</span><span class="loc">◍ {c.app.inv.aisle} {r.loc.split(" · ")[0]} · {c.app.inv.rack} {r.loc.split(" · ")[1]}</span><span class="used">{c.app.inv.usedIn} {r.used} {c.app.inv.perUnit})</span></td><td class="num">{r.cat}</td><td class="num r">{r.stock}</td><td class="num r">{r.min}</td><td class="num r">{r.need}</td><td class={"num r " + r.covCls}>{r.cov} {c.app.inv.days}</td><td class="num r">{r.cost}</td><td><span class={"rb " + r.riskCls}><span></span>{r.risk}</span></td><td class="num">{r.sup}</td><td class="r ACT"></td></tr>))}
                </tbody>
              </table></div>
            </div>

            <!-- ORDERS -->
            <div class="panel" data-panel="orders">
              <div class="pagehead"><h2>{c.app.nav.orders}</h2><div class="ph-actions"><span class="ph-btn primary">{c.app.ord.newOrder}</span></div></div>
              <div class="subtabs">{c.app.ord.subtabs.map((t, i) => (i === 0 ? <span class="on">{t}</span> : <span>{t}</span>))}</div>
              <div class="tracking"><span class="dot"></span>{c.app.ord.tracking}</div>
              <div class="filters">{c.app.ord.filters.map((f, i) => (<span class={"fpill" + (i === 0 ? " onteal" : "")}>{f}</span>))}</div>
              <div class="tbl-scroll"><table class="tbl">
                <thead><tr>{c.app.ord.head.map((h, i) => (<th class={i === 3 || i === 5 ? "r" : undefined}>{h}</th>))}</tr></thead>
                <tbody>
                  {c.app.ord.rows.map((r) => (
                  <tr><td class="sku">{r.po}</td><td class="num">{r.sup}</td><td class="num">{r.item}</td><td class="num r">{r.amt}</td><td>{r.prep && <span class="prep">{c.app.ord.prep}</span>}<div class="stepper">{c.app.ord.steps.map((st, i) => (<span><i class={i < r.done ? "done" : ("wait" in r && r.wait && i === r.done ? "wait" : undefined)}></i><em>{st}</em></span>))}</div></td><td class="r"><span class="actbtns"><span>PDF</span>{r.why ? <span class="ai">{c.app.ord.why}</span> : <span>{c.app.ord.portal}</span>}</span></td></tr>))}
                </tbody>
              </table></div>
              <div class="replies">
                <h4>{c.app.ord.repliesTitle}</h4>
                <div class="rgrid">
                  {c.app.ord.replies.map((r) => (
                  <div class="rcard"><div class="from">{r.from}</div><div class="subj">{r.subj}</div><div class="foot"><span class={"rbadge " + r.cls}>{r.badge}</span><span class="ago">{r.ago}</span></div></div>))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band"><div class="shell trust">{c.band.map((b) => (<span class="mono">{b}</span>))}</div></section>

  <section class="figs-pin-wrap" id="figsPin">
    <div class="figs-pin">
      <div class="shell">
        <div class="fig-lede">
          <div class="fig-over"><span class="chip"><span class="sq"></span>{c.figs.chip}</span></div>
          <p class="fig-lede-p"><b>{c.figs.ledeB}</b>{c.figs.ledeP}</p>
        </div>
        <div class="figs" id="figs"></div>
      </div>
    </div>
  </section>

  <section class="ctrl">
    <div class="shell">
      <div class="ctrl-grid">
        <aside class="ctrl-nav">
          <span class="chip"><span class="sq"></span>{c.ctrl.chip}</span>
          <h2 class="pf-h">{c.ctrl.h2}</h2>
          <p class="pf-sub">{c.ctrl.sub}</p>
          <ul id="pfNav">
            {/* the sub-label needs its own element: the reveal animates grid-template-rows on the
                span, and a bare text node becomes an anonymous grid item that cannot collapse */}
            {c.ctrl.nav.map((n) => (<li><b>{n.b}</b><span><i>{n.s}</i></span></li>))}
          </ul>
        </aside>
        <div class="ctrl-track" id="ctrlTrack">
            <article class="ctrl-block">
              <h3>{c.ctrl.b1.h}</h3>
              <p>{c.ctrl.b1.p}</p>
              <div class="pf-panel">
                <div class="thr">
                  <div class="thr-top"><span class="thr-val">{c.ctrl.b1.val}</span><span class="thr-cap">{c.ctrl.b1.cap}</span></div>
                  <div class="thr-track"><div class="thr-fill"></div><div class="thr-knob"></div></div>
                  <div class="thr-scale"><span>{c.ctrl.b1.lo}</span><span>{c.ctrl.b1.hi}</span></div>
                </div>
                <div class="pp-orders">
                  {c.ctrl.b1.orders.map((o, i) => (
                    <div class={"oline" + (i === 2 ? " hot" : "")}><span class={"odot " + (i === 2 ? "coral" : "teal")}></span><span class="oname">{o.n}</span><span class="oamt">{o.a}</span><span class={"ob " + (i === 2 ? "freig" : "auto")}>{o.b}</span></div>))}
                </div>
              </div>
              <div class="ctrl-sub">
                {c.ctrl.b1.sub.map((x) => (<div><h4>{x.h}</h4><p>{x.p}</p></div>))}
              </div>
            </article>
            <article class="ctrl-block">
              <h3>{c.ctrl.b2.h}</h3>
              <p>{c.ctrl.b2.p}</p>
              <div class="pf-panel">
                <div class="canvas">
                  <div class="cv-in">
                    <svg class="cv-svg" viewBox="0 0 660 400" preserveAspectRatio="none" aria-hidden="true">
                      <path d="M232 52 C 300 52, 360 52, 428 52"/>
                      <path d="M536 84 C 536 130, 167 126, 167 168"/>
                      <path class="tealln" d="M310 202 C 348 202, 346 201, 384 201"/>
                      <path class="hot" d="M310 250 C 348 250, 348 333, 384 333"/>
                    </svg>
                    <div class="cnode" style="left:16px; top:20px; width:216px;">
                      <span class="cbadge">{c.ctrl.b2.n1b}</span>
                      <div class="cn-h"><span class="cn-ic teal">◷</span><span class="cn-t">{c.ctrl.b2.n1t}</span></div>
                      <div class="cn-s">{c.ctrl.b2.n1s}</div>
                    </div>
                    <div class="cnode" style="left:428px; top:20px; width:216px;">
                      <span class="cbadge">{c.ctrl.b2.n2b}</span>
                      <div class="cn-h"><span class="cn-ic teal">⇄</span><span class="cn-t">{c.ctrl.b2.n2t}</span></div>
                      <div class="cn-s">{c.ctrl.b2.n2s}</div>
                    </div>
                    <div class="cnode" style="left:24px; top:168px; width:286px;">
                      <span class="cbadge">{c.ctrl.b2.n3b}</span>
                      <div class="cn-h"><span class="cn-ic amber">⋔</span><span class="cn-t">{c.ctrl.b2.n3t}</span></div>
                      <div class="cn-checks">
                        {c.ctrl.b2.checks.map((k) => (<div class="cn-chk"><span class="ck">✓</span>{k}</div>))}
                      </div>
                    </div>
                    <div class="clabel teal" style="left:330px; top:190px;">{c.ctrl.b2.yes}</div>
                    <div class="clabel coral" style="left:326px; top:288px;">{c.ctrl.b2.no}</div>
                    <div class="cnode" style="left:384px; top:170px; width:256px;">
                      <span class="cbadge ok">{c.ctrl.b2.n4b}</span>
                      <div class="cn-h"><span class="cn-ic teal">✓</span><span class="cn-t">{c.ctrl.b2.n4t}</span></div>
                      <div class="cn-s">{c.ctrl.b2.n4s}</div>
                    </div>
                    <div class="cnode" style="left:384px; top:302px; width:256px;">
                      <span class="cbadge esc">{c.ctrl.b2.n5b}</span>
                      <div class="cn-h"><span class="cn-ic coral">◔</span><span class="cn-t">{c.ctrl.b2.n5t}</span></div>
                      <div class="cn-s">{c.ctrl.b2.n5s}</div>
                    </div>
                  </div>
                </div>
                <div class="pp-note">{c.ctrl.b2.note}</div>
              </div>
              <div class="ctrl-sub">
                {c.ctrl.b2.sub.map((x) => (<div><h4>{x.h}</h4><p>{x.p}</p></div>))}
              </div>
            </article>
            <article class="ctrl-block">
              <h3>{c.ctrl.b3.h}</h3>
              <p>{c.ctrl.b3.p}</p>
              <div class="bento">
                <div class="bt big">
                  <div class="donut-c">
                    <svg class="donut" viewBox="0 0 100 100" aria-hidden="true">
                      <circle class="track" cx="50" cy="50" r="42"/>
