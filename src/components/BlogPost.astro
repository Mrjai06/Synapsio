---
// A single post. One measure of text, nothing beside it: a sidebar or a floating share rail would
// only compete with the reading column, and the site has no interaction budget anyway.
import { render, type CollectionEntry } from "astro:content";
import { blogCopy, formatDate } from "../i18n/blog";
import { localePath, CAL_URL, type Locale } from "../i18n/ui";
import SiteNav from "./SiteNav.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props { locale: Locale; post: CollectionEntry<"blog"> }
const { locale, post } = Astro.props;
const c = blogCopy[locale];
const p = (path: string) => localePath(locale, path);
// Astro 5 content layer: render(entry), not entry.render() (that is the pre-5 API and throws).
const { Content } = await render(post);
---

<SiteNav locale={locale} path="/blog" active="blog" />

<main>
  <article class="shell po">
    <a class="po-back" href={p("/blog")}>{c.back}</a>
    <div class="po-meta">
      <span class="mono po-tag">{post.data.tag}</span>
      <span class="mono">{formatDate(post.data.date, locale)}</span>
      <span class="mono">{c.readingTime(post.data.readingTime)}</span>
    </div>
    <h1>{post.data.title}</h1>
    <p class="po-lede">{post.data.description}</p>
    <div class="po-body">
      <Content />
    </div>
  </article>

  <section class="shell po-close">
    <h2>{c.ctaH}</h2>
    <p>{c.ctaP}</p>
    <a class="btn lg primary" href={CAL_URL}>{c.cta}</a>
  </section>

  <SiteFooter locale={locale} />
</main>

<style>
  .po { padding-block:clamp(40px,6vh,72px) clamp(40px,6vh,72px); }
  .po-back { display:inline-block; color:var(--fg-muted); text-decoration:none; font-size:13.5px;
    transition:color 160ms ease; }
  .po-back:hover { color:var(--fg); }
  .po-back::before { content:"← "; }
  .po-meta { display:flex; flex-wrap:wrap; gap:16px; align-items:baseline; margin-top:clamp(26px,4vh,42px); }
  .po-tag { color:var(--teal-soft); }
  .po h1 { margin:14px 0 0; max-width:22ch; font-size:clamp(1.9rem,4.2vw,3.1rem); font-weight:600;
    letter-spacing:-0.03em; line-height:1.08; text-wrap:balance; }
  .po-lede { margin:20px 0 0; max-width:58ch; font-size:1.05rem; line-height:1.6; color:var(--fg-soft); }

  /* The reading column. 16px is the web body floor; the leading and the slight positive tracking
     are there because light type on a dark ground reads thinner than it measures. */
  .po-body { max-width:64ch; margin-top:clamp(30px,4.5vh,50px); padding-top:clamp(28px,4vh,44px);
    border-top:1px solid var(--hairline); }
  .po-body :global(p) { margin:0 0 20px; font-size:16px; line-height:1.75; letter-spacing:0.004em;
    color:var(--fg-soft); }
  .po-body :global(h2) { margin:clamp(34px,5vh,52px) 0 14px; font-size:clamp(1.2rem,2.1vw,1.5rem);
    font-weight:600; letter-spacing:-0.018em; color:var(--fg); text-wrap:balance; }
  .po-body :global(strong) { color:var(--fg); font-weight:600; }
  .po-body :global(em) { font-style:italic; }
  .po-body :global(a) { color:var(--fg); text-decoration:none; border-bottom:1px solid var(--hairline-strong); }
  .po-body :global(a:hover) { color:var(--coral); border-bottom-color:var(--coral); }
  /* Blockquote carries the formulas, so it is a spec block rather than a pull quote.
     A 2px coloured left rail was the first version; the detector flags that as `side-tab`, the
     most recognisable tell of generated UI. A hairline box says "specification" without it. */
  .po-body :global(blockquote) { margin:26px 0; padding:17px 20px; border:1px solid var(--hairline);
    border-radius:8px; background:rgba(255,255,255,0.022); }
  .po-body :global(blockquote p) { margin:0 0 8px; font-family:var(--mono); font-size:13.5px;
    line-height:1.6; color:var(--fg); letter-spacing:0; }
  .po-body :global(blockquote p:last-child) { margin-bottom:0; }
  .po-body :global(ul), .po-body :global(ol) { margin:0 0 20px; padding-left:20px; color:var(--fg-soft);
    font-size:16px; line-height:1.75; }
  .po-body :global(li) { margin-bottom:8px; }
  .po-body :global(code) { font-family:var(--mono); font-size:13.5px; color:var(--fg);
    background:rgba(255,255,255,0.05); padding:1px 5px; border-radius:4px; }
  .po-body :global(hr) { border:0; border-top:1px solid var(--hairline); margin:34px 0; }

  .po-close { padding-block:clamp(46px,7vh,86px) clamp(56px,8vh,100px); border-top:1px solid var(--hairline);
    text-align:center; }
  .po-close h2 { font-size:clamp(1.45rem,2.6vw,2rem); font-weight:600; letter-spacing:-0.02em; }
  .po-close p { margin:13px auto 24px; max-width:46ch; color:var(--fg-soft); font-size:15.5px; }
</style>
