---
// /ueber-uns's own object: a workbench.
//
// WHY A BENCH, AND WHY NOT THE SPHERE. NeuralSphere anchors the startpage hero, the security
// section owns the dome, the blog owns the tape and its pen. A device appears ONCE on this site,
// and that rule is the only reason the five pages do not read as variants of one template.
// A bench also says what the page says: a small team that knows the operational side first hand.
//
// MOTION CONTRACT (the site's rule): the OBJECT may animate on scroll, the prose never does.
// One reveal, ease-out, once, and reduced motion shows it finished. No render loop: this is
// static SVG, so it costs one paint.
//
// ISO ENGINE: the same basis as ArchivDrawer and HorizonteIso. x runs down-right, y down-left,
// z up. Faces carry `.face` / `.face.lit` so the bench uses the same material as the startpage
// figures, which is what stops a new drawing reading as a decal laid on the design.

const RX = [0.866, 0.5];
const RY = [-0.866, 0.5];
const P = (x: number, y: number, z: number): [number, number] => [
  x * RX[0] + y * RY[0],
  x * RX[1] + y * RY[1] - z,
];
const poly = (...p: [number, number][]) =>
  p.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");

/** Three visible faces of an axis-aligned box: top (lit), the -y flank, the +x flank.
 *  Returned back-to-front so a caller can concat boxes in draw order and be done. */
function box(x: number, y: number, z: number, w: number, d: number, h: number) {
  return {
    top: poly(P(x, y, z + h), P(x + w, y, z + h), P(x + w, y + d, z + h), P(x, y + d, z + h)),
    front: poly(P(x, y, z), P(x + w, y, z), P(x + w, y, z + h), P(x, y, z + h)),
    side: poly(P(x + w, y, z), P(x + w, y + d, z), P(x + w, y + d, z + h), P(x + w, y, z + h)),
  };
}

// ---- the bench ------------------------------------------------------------------------------
const BW = 210, BD = 104, TOPT = 9;      // bench: width along x, depth along y, top thickness
const LEGH = 62, LEG = 11;
const TOPZ = LEGH;

const top = box(0, 0, TOPZ, BW, BD, TOPT);
const shelf = box(6, 6, 20, BW - 12, BD - 12, 5);
// Legs are drawn before the top so the top occludes them, and the two far ones before the near.
const legs = [
  box(BW - LEG - 4, BD - LEG - 4, 0, LEG, LEG, LEGH),   // far right
  box(4, BD - LEG - 4, 0, LEG, LEG, LEGH),              // far left
  box(BW - LEG - 4, 4, 0, LEG, LEG, LEGH),              // near right
  box(4, 4, 0, LEG, LEG, LEGH),                         // near left
];

// ---- what is ON the bench -------------------------------------------------------------------
const Z = TOPZ + TOPT;

// Three open parts bins in a row. An open bin reads instantly; a closed box is just a cube, and
// a cube is the one shape this site's figure rule bans.
const BINW = 34, BIND = 40, BINH = 15, BINGAP = 8;
const bins = [0, 1, 2].map((i) => {
  const x = 18 + i * (BINW + BINGAP);
  const y = BD - BIND - 14;
  return {
    shell: box(x, y, Z, BINW, BIND, BINH),
    // the contents sit just below the rim, so the bin reads as open rather than as a lid
    fill: poly(
      P(x + 3, y + 3, Z + BINH - 4), P(x + BINW - 3, y + 3, Z + BINH - 4),
      P(x + BINW - 3, y + BIND - 3, Z + BINH - 4), P(x + 3, y + BIND - 3, Z + BINH - 4),
    ),
    hot: i === 1,
  };
});

// A clipboard lying flat, with its clip and two ruled lines. This is the piece of paper the
// whole product replaces, so it earns its place.
const CX = 132, CY = 16, CW = 58, CD = 74;
const board = poly(P(CX, CY, Z + 1), P(CX + CW, CY, Z + 1), P(CX + CW, CY + CD, Z + 1), P(CX, CY + CD, Z + 1));
const clip = box(CX + CW / 2 - 9, CY + CD - 13, Z + 1, 18, 9, 4);
const rules = [0.34, 0.5, 0.66].map((k) =>
  poly(P(CX + 7, CY + CD * k, Z + 2), P(CX + CW - 7, CY + CD * k, Z + 2)),
);

// A bench lamp: a post and a shade, with the light falling on the top. The only warm thing here,
// which is how the rest of the site handles a single accent, so it stays small.
// ⚠️ A light POOL and two crates were drawn here and both are gone. The pool covered half the
// bench in a pale slab that read as a stain, and the crates were a dark shape with no silhouette
// of their own. Neither added information, and this object's whole lesson (see the drawer) is
// that fewer competing planes win. A bench lamp: short, over the bins, where a bench lamp is.
const LX = 30, LY = 26, LZ = Z, LH = 38;
const post = box(LX, LY, LZ, 4, 4, LH);
const shade = box(LX - 7, LY - 6, LZ + LH, 19, 17, 4.5);

// viewBox from the projected extents of everything that is drawn, plus a margin. Computing it
// from the geometry rather than guessing is what stops the object sitting in one corner of its
// own frame, which cost three passes on the drawer.
const all: [number, number][] = [];
[[0, 0, 0], [BW, 0, 0], [BW, BD, 0], [0, BD, 0],
 [0, 0, Z], [BW, 0, Z], [BW, BD, Z], [0, BD, Z],
 [LX - 12, LY - 11, LZ + LH + 6], [LX + 18, LY + 15, LZ + LH + 6],
 [LX, LY, LZ + LH + 6]].forEach(([x, y, z]) => all.push(P(x, y, z)));
const xs = all.map((p) => p[0]), ys = all.map((p) => p[1]);
const M = 14;
const vb = [
  Math.min(...xs) - M, Math.min(...ys) - M,
  Math.max(...xs) - Math.min(...xs) + M * 2, Math.max(...ys) - Math.min(...ys) + M * 2,
];
---

<figure class="wk" data-wk aria-hidden="true">
  <svg viewBox={vb.map((n) => n.toFixed(1)).join(" ")} role="presentation">
    {/* legs first: the top has to occlude them */}
    {legs.map((l) => (<>
      <polygon class="face" points={l.front} />
      <polygon class="face" points={l.side} />
      <polygon class="face lit" points={l.top} />
    </>))}

    <polygon class="face" points={shelf.front} />
    <polygon class="face" points={shelf.side} />
    <polygon class="face lit" points={shelf.top} />
    <polygon class="face" points={top.front} />
    <polygon class="face" points={top.side} />
    <polygon class="face lit wk-top" points={top.top} />

    <polygon class="wk-board" points={board} />
    {rules.map((r) => (<polyline class="wk-rule" points={r} />))}
    <polygon class="face" points={clip.front} />
    <polygon class="face" points={clip.side} />
    <polygon class="face lit" points={clip.top} />

    {bins.map((b) => (<>
      <polygon class="face" points={b.shell.front} />
      <polygon class="face" points={b.shell.side} />
      <polygon class="face lit" points={b.shell.top} />
      <polygon class={b.hot ? "wk-fill hot" : "wk-fill"} points={b.fill} />
    </>))}

    <polygon class="face" points={post.front} />
    <polygon class="face" points={post.side} />
    <polygon class="face" points={shade.front} />
    <polygon class="face" points={shade.side} />
    <polygon class="face lit wk-shade" points={shade.top} />
  </svg>
</figure>

<style>
  .wk { margin: 0; display: block; }
  .wk svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* the bench top catches the lamp, so it is a step lighter than the rest of the object */
  .wk .wk-top { fill: color-mix(in oklab, var(--face-hi) 82%, #cfe4ea); }
  .wk .wk-shade { fill: #d2a765; stroke: rgba(240, 196, 130, 0.55); }

  /* Paper, in the tone the security dome already uses for it. At #d6e2e6 the board was the
     brightest thing on a near-black page and pulled the eye off the bench. */
  .wk .wk-board { fill: #20404e; stroke: rgba(214, 230, 236, 0.5); stroke-width: 1;
    vector-effect: non-scaling-stroke; }
  .wk .wk-rule { fill: none; stroke: rgba(206, 222, 228, 0.5); stroke-width: 1.4;
    vector-effect: non-scaling-stroke; }

  .wk .wk-fill { fill: #2f5f66; stroke: none; }
  .wk .wk-fill.hot { fill: var(--coral); }

  /* One reveal, once, ease-out, transform and opacity only. Gated on html[data-js] so a no-JS
     render shows the object plainly rather than an empty box, and every rule in the group
     carries the same prefix (the [data-shot] trap, paid for once already). */
  :global(html[data-js]) .wk { opacity: 0; transform: translateY(12px); }
  :global(html[data-js]) .wk.in {
    opacity: 1; transform: none;
    transition: opacity 420ms var(--ease-out), transform 420ms var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js]) .wk { opacity: 1; transform: none; }
    :global(html[data-js]) .wk.in { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var els = document.querySelectorAll("[data-wk]");
    if (!els.length) return;
    if (!("IntersectionObserver" in window)) {
      els.forEach(function (e) { e.classList.add("in"); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        en.target.classList.add("in");
        io.unobserve(en.target);          // never re-runs on scroll back
      });
    }, { rootMargin: "0px 0px -12% 0px" });
    els.forEach(function (e) { io.observe(e); });
  })();
</script>
