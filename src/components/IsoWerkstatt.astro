---
// /ueber-uns's own object: the desk the company actually works at.
//
// WHY A DESK, AND WHY NOT THE SPHERE. NeuralSphere anchors the startpage hero, the security
// section owns the dome, the blog owns the tape and its pen. A device appears ONCE on this site,
// and that rule is the only reason the five pages do not read as variants of one template.
//
// ENGINE. Earlier passes hand-picked which three faces of a box to draw, which is why the lamp
// could only ever be a post (an angled arm has no "front" and "side") and why a mug had to be a
// cube. Faces are now built in 3D, culled by their own normal and sorted by depth, so any prism
// at any angle and any surface of revolution just works.
//   x runs down-right, y down-left, z up. A face is visible when its normal points along
//   (1,1,1); the same dot product is the painter key. SMALL y is the back of the desk.
//
// MOTION (the site's rule: the OBJECT may animate, prose never does). Two things, both once, both
// on reveal: the laptop lid swings open, then the lamp strikes and the screens come up with it.

type V3 = [number, number, number];
const add = (a: V3, b: V3): V3 => [a[0] + b[0], a[1] + b[1], a[2] + b[2]];
const mul = (a: V3, k: number): V3 => [a[0] * k, a[1] * k, a[2] * k];
const sub = (a: V3, b: V3): V3 => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
const cross = (a: V3, b: V3): V3 =>
  [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
const len = (a: V3) => Math.hypot(a[0], a[1], a[2]);
const norm = (a: V3): V3 => mul(a, 1 / (len(a) || 1));
const VIEW: V3 = [1, 1, 1];
const vdot = (a: V3) => a[0] + a[1] + a[2];

const RX = [0.866, 0.5];
const RY = [-0.866, 0.5];
const P2 = (p: V3): [number, number] => [
  p[0] * RX[0] + p[1] * RY[0],
  p[0] * RX[1] + p[1] * RY[1] - p[2],
];

/* `lay` is a hard draw order, and it exists because a single depth key cannot express a desk.
   The top is one enormous quad whose key sits at its own centre, so sorting by depth alone put
   the pedestal OVER the top and everything on the desk's front half UNDER it. A bias fixed one
   and broke the other. Layers state the truth instead:
     0 under the desk   1 the top itself   2 on the desk   3 light, which falls on everything */
interface Face { p: V3[]; cls: string; bias?: number; lay?: number; n?: V3 }
const S: Face[] = [];
const push = (f: Face) => { S.push(f); return f; };

/** Prism from an origin and three edge vectors. All six faces; the culler picks. */
function prism(o: V3, u: V3, v: V3, w: V3, cls: string, lay = 2, capless = false) {
  const k = (a: number, b: number, c: number): V3 =>
    add(add(add(o, mul(u, a)), mul(v, b)), mul(w, c));
  const A = k(0, 0, 0), B = k(1, 0, 0), C = k(1, 1, 0), D = k(0, 1, 0);
  const E = k(0, 0, 1), F = k(1, 0, 1), G = k(1, 1, 1), H = k(0, 1, 1);
  push({ p: [A, B, C, D], cls, lay });
  if (!capless) push({ p: [E, F, G, H], cls: `${cls} lit`, lay });
  push({ p: [A, B, F, E], cls, lay });
  push({ p: [D, C, G, H], cls, lay });
  push({ p: [A, D, H, E], cls, lay });
  push({ p: [B, C, G, F], cls, lay });
}
/** Axis-aligned convenience. */
const bx = (x: number, y: number, z: number, w: number, d: number, h: number, cls = "face", lay = 2) =>
  prism([x, y, z], [w, 0, 0], [0, d, 0], [0, 0, h], cls, lay);
/** A flat panel lying at height z. Winding gives +z, so it survives the cull. */
const pad = (x: number, y: number, z: number, w: number, d: number, cls: string, bias = 0.4, lay = 2) =>
  push({ p: [[x, y, z], [x + w, y, z], [x + w, y + d, z], [x, y + d, z]], cls, bias, lay });
/** An OPEN tray: walls, an inner floor and a rim. No lid.
 *  ⚠️ A prism has a top face, so a "bin" made from one is a closed box: the contents are drawn,
 *  then the lid is drawn over them, and the whole point of an open bin is lost. That is why the
 *  coral one had gone dark. */
function tray(x: number, y: number, z: number, w: number, d: number, h: number, fill: string) {
  prism([x, y, z], [w, 0, 0], [0, d, 0], [0, 0, h], "face", 2, true);
  // Well inside the walls and well below the rim: at a 2.5 inset the contents sorted level with
  // the front wall and appeared to spill over its edge.
  pad(x + 4.5, y + 4.5, z + h - 5, w - 9, d - 9, fill, 0.4);
  const t = 1.8;                                     // the rim, as four thin tops
  pad(x, y, z + h, w, t, "face lit", 0.6);
  pad(x, y + d - t, z + h, w, t, "face lit", 0.6);
  pad(x, y + t, z + h, t, d - 2 * t, "face lit", 0.6);
  pad(x + w - t, y + t, z + h, t, d - 2 * t, "face lit", 0.6);
}
/** A panel standing in a constant-y plane, facing the viewer.
 *  ⚠️ The winding matters and is not obvious: (x0,z0) → (x0,z1) → (x1,z1) → (x1,z0) gives a +y
 *  normal. Written the intuitive way round it gives -y, the culler drops it, and every screen,
 *  drawer front and handle silently disappears. That is exactly what happened once. */
const panelY = (x0: number, x1: number, z0: number, z1: number, y: number, cls: string, bias = 0.4, lay = 2) =>
  push({ p: [[x0, y, z0], [x0, y, z1], [x1, y, z1], [x1, y, z0]], cls, bias, lay });

/** A surface of revolution between two circles, drawn as ONE polygon.
 *  ⚠️ Emitting N separate quads gives every one of them the stroke that .face carries, so a
 *  cylinder came out as twenty vertical lines and read as a coil spring. That is what made the
 *  lamp base and the mug look wrong. Only the visible arc is drawn, and it is a single face, so
 *  the outline is the silhouette and nothing else. */
function revolve(c0: V3, r0: number, c1: V3, r1: number, e1: V3, e2: V3, cls: string, lay = 2) {
  const N = 40;
  const at = (c: V3, r: number, i: number): V3 =>
    add(c, add(mul(e1, r * Math.cos((i / N) * 2 * Math.PI)), mul(e2, r * Math.sin((i / N) * 2 * Math.PI))));
  const vis: number[] = [];
  for (let i = 0; i < N; i++) {
    // ⚠️ ORDER. cross(tangent, axial) is the OUTWARD radial normal; the other way round it points
    // inward, so the far half of the surface is kept and the near half thrown away. On a plain
    // cylinder that is nearly invisible, because the silhouette is the same either way, which is
    // why the lamp base looked fine while the mug came out as a crescent and the shade vanished.
    const n = cross(sub(at(c0, r0, i + 1), at(c0, r0, i)), sub(at(c1, r1, i), at(c0, r0, i)));
    if (vdot(n) > 0) vis.push(i);
  }
  if (vis.length) {
    // the visible band wraps, so rotate it to a contiguous run before building the outline
    let start = 0;
    for (let k = 0; k < vis.length; k++) {
      if (vis[(k + vis.length - 1) % vis.length] !== (vis[k] + N - 1) % N) { start = k; break; }
    }
    const run = vis.map((_, k) => vis[(start + k) % vis.length]);
    const lo = run.map((i) => at(c0, r0, i));
    lo.push(at(c0, r0, run[run.length - 1] + 1));
    const hi = run.map((i) => at(c1, r1, i));
    hi.push(at(c1, r1, run[run.length - 1] + 1));
    // ⚠️ The cull derives a normal from a face's first three points. On this band those are
    // three points of the SAME circle, so it would get the ring's plane normal, not the surface
    // normal, and a shade aimed downward would be deleted while a cylinder survived by accident.
    // The outward radial at the middle of the run is handed over explicitly.
    const mid = run[Math.floor(run.length / 2)];
    const nOut = sub(at(c0, r0 + 1, mid), at(c0, r0, mid));
    push({ p: [...lo, ...hi.reverse()], cls, lay, n: nOut });
  }
  push({ p: Array.from({ length: N }, (_, i) => at(c1, r1, i)), cls: `${cls} lit`, bias: 0.4, lay });
}
/** The same band without its cap, for shapes that paint their own (a lamp shade's mouth). */
function revolveNoCap(c0: V3, r0: number, c1: V3, r1: number, e1: V3, e2: V3, cls: string, lay = 2) {
  const before = S.length;
  revolve(c0, r0, c1, r1, e1, e2, cls, lay);
  S.splice(before + (S.length - before) - 1, 1);       // drop the cap revolve() appended
}
/** Upright cylinder. */
const cyl = (cx: number, cy: number, z: number, r: number, h: number, cls = "face", lay = 2) =>
  revolve([cx, cy, z], r, [cx, cy, z + h], r, [1, 0, 0], [0, 1, 0], cls, lay);

// ---- desk -------------------------------------------------------------------------------------
// An OFFICE desk, not a workbench: a thin top on slim legs with a drawer pedestal. The previous
// version had a thick top, chunky legs and a full lower shelf, which is a joiner's bench.
const DW = 226, DD = 116, TOPT = 5, LEGH = 64, LEG = 5;
const Z = LEGH + TOPT;
[[10, 10], [DW - 10 - LEG, 10], [10, DD - 10 - LEG], [DW - 10 - LEG, DD - 10 - LEG]]
  // Legs on their own layer above the rails and the pedestal: they stand in front of both, and a
  // depth key taken at a long face's middle keeps losing that argument.
  .forEach(([x, y]) => bx(x, y, 0, LEG, LEG, LEGH, "face", 0.6));
// Side rails, so the legs belong to one frame rather than standing loose.
// ⚠️ SPLIT INTO SEGMENTS. As one box each, a rail is a single long face whose painter key sits at
// its own middle, so it was drawn AFTER the legs standing in front of it and painted a line
// straight through them. That is what "the legs are see-through" was: not transparency, a large
// face winning a depth comparison it should have lost. Segments key locally and behave.
for (let i = 0; i < 8; i++) {
  const w = (DW - 20) / 8, x = 10 + i * w;
  bx(x, 12, LEGH - 9, w, 3, 4, "face", 0);
  bx(x, DD - 15, LEGH - 9, w, 3, 4, "face", 0);
}
// ⚠️ NOT split. Segmenting it, which is the right fix for the rails, left three visible seams
// down its front: a rail is hidden behind legs, a pedestal face is the thing you look at.
// It gets a layer under the legs instead, which is the truth anyway.
bx(DW - 74, 16, 0, 58, DD - 32, LEGH - 2, "face", 0.2);        // pedestal
[0.12, 0.42, 0.72].forEach((k) => {                            // three drawer fronts + handles
  const z = 6 + k * (LEGH - 14);
  // Same layer as the pedestal they sit on, or the pedestal is drawn after them and they vanish.
  panelY(DW - 71, DW - 19, z, z + 14, DD - 16, "wk-drawer", 0.4, 0.2);
  panelY(DW - 52, DW - 38, z + 10, z + 11.6, DD - 16.2, "wk-pull", 0.8, 0.2);
});
bx(0, 0, LEGH, DW, DD, TOPT, "face wk-topslab", 1);

// ---- two monitors, behind the laptop ------------------------------------------------------------
const MPT = 3.5, MRISE = 15;
/** One monitor: a flat base plate, a thick column, a panel with real thickness. Taken from the
 *  reference desk rather than invented: a portrait screen beside a landscape one is what the
 *  setup actually looks like, and the two shapes together stop the pair reading as wallpaper. */
function monitor(mx: number, my: number, w: number, h: number, rows: number, accentRow: number) {
  const bwid = Math.min(w - 8, 34);
  bx(mx + w / 2 - bwid / 2, my + 2, Z, bwid, 17, 2.2, "face");   // base plate
  bx(mx + w / 2 - 5, my + 6.5, Z + 2.2, 10, 7, MRISE);           // column
  bx(mx, my, Z + MRISE, w, MPT, h);                              // panel
  const y = my + MPT, z0 = Z + MRISE;
  panelY(mx + 3, mx + w - 3, z0 + 3, z0 + h - 3, y, "wk-screen", 0.5);
  const widths = [0.74, 0.42, 0.62, 0.3, 0.55, 0.36, 0.66];
  for (let i = 0; i < rows; i++) {
    const zz = z0 + h - 9 - (i / rows) * (h - 18);
    panelY(mx + 8, mx + 8 + (w - 16) * widths[i % widths.length], zz, zz + 2.6, y,
      i === accentRow ? "wk-row hot" : "wk-row", 0.9);
  }
}
monitor(34, 10, 44, 68, 7, 1);        // portrait
monitor(88, 10, 78, 46, 4, 2);        // landscape

// ---- laptop -------------------------------------------------------------------------------------
const LX = 86, LY = 50, LW = 62, LD = 42, LBASE = 4;
const LIDL = 40, LIDOPEN = 1.92;
const ZB = Z + LBASE;
bx(LX, LY, Z, LW, LD, LBASE);
pad(LX + 5, LY + 5, ZB, LW - 10, LD - 19, "wk-keys");
pad(LX + LW / 2 - 10, LY + LD - 12, ZB, 20, 8, "wk-pad");

/* Anything drawn ON the lid is given in the LID'S OWN coordinates: x across it, k along it from
   the hinge (k=0) to the free edge (k=1). One interpolation serves the build and the runtime, so
   the screen content cannot drift off the panel it sits on. */
const LID_INSETS = [
  { cls: "wk-screen wk-lidscreen", x0: 4, x1: LW - 4, k0: 0.1, k1: 0.92 },
  { cls: "wk-row hot wk-lidrow", x0: 9, x1: LW - 22, k0: 0.79, k1: 0.845 },
  { cls: "wk-row wk-lidrow", x0: 9, x1: LW - 14, k0: 0.68, k1: 0.735 },
  { cls: "wk-row wk-lidrow", x0: 9, x1: LW - 30, k0: 0.57, k1: 0.625 },
];
function lidAt(t: number) {
  const dy = LIDL * Math.cos(t), dz = LIDL * Math.sin(t);
  const q = (x: number, k: number): V3 => [LX + x, LY + dy * k, ZB + dz * k];
  const pl = (...p: V3[]) => p.map((v) => P2(v).map((n) => n.toFixed(1)).join(",")).join(" ");
  return {
    lid: pl(q(0, 0), q(LW, 0), q(LW, 1), q(0, 1)),
    insets: LID_INSETS.map((i) => pl(q(i.x0, i.k0), q(i.x1, i.k0), q(i.x1, i.k1), q(i.x0, i.k1))),
  };
}
const lid0 = lidAt(LIDOPEN);

/* ---- the light: a pendant hanging into the frame from above -----------------------------------
   The desk lamp is gone. Three passes at it produced an articulated arm that still read as a
   music stand at this size, because a jointed lamp needs more pixels than it gets here. A pendant
   is one cord and one cone, which survives being small, and it can SWING, which is the only
   motion on this object that repeats.
   ⚠️ Everything on lay 4 is emitted inside its own <g> and rotated as a unit. The swing is a 2D
   rotation about the cord's anchor: a small pendulum about a horizontal axis projects to almost
   exactly that, and rebuilding the geometry per frame for a 2 degree sway would be waste. */
const PX = 108, PY = 46;                       // the pendant hangs over the laptop
// ⚠️ Hung at Z+74 with a 26 radius the shade filled the middle of the picture and covered the
// laptop it was meant to light. A pendant reads from its SILHOUETTE, so it can be small; what it
// cannot be is in the way.
const PZTOP = Z + 186, PZSH = Z + 104;         // cord anchor, and where the shade begins
bx(PX - 1, PY - 1, PZSH + 10, 2, 2, PZTOP - PZSH - 10, "face wk-cord", 4);
bx(PX - 4, PY - 4, PZSH + 7, 8, 8, 4, "face", 4);          // the fitting at the top of the shade

/** Truncated cone on an arbitrary axis. Its mouth is wound BACKWARDS on purpose: a shade aimed at
 *  the desk points its opening away from this camera, a correct cull deletes it, and the lamp then
 *  reads as unlit metal. The glow is the reason the lamp is in the picture. */
function cone(c0: V3, r0: number, c1: V3, r1: number, cls: string, lit: string) {
  const ax = norm(sub(c1, c0));
  const e1 = norm(cross(ax, Math.abs(ax[2]) > 0.9 ? ([1, 0, 0] as V3) : ([0, 0, 1] as V3)));
  const e2 = cross(ax, e1);
  revolveNoCap(c0, r0, c1, r1, e1, e2, cls, 4);
  const N = 30;
  const ring = (i: number): V3 =>
    add(c1, add(mul(e1, r1 * Math.cos((i / N) * 2 * Math.PI)), mul(e2, r1 * Math.sin((i / N) * 2 * Math.PI))));
  push({ p: Array.from({ length: N }, (_, i) => ring(N - i)), cls: lit, bias: 0.6, lay: 4 });
}
cone([PX, PY, PZSH + 9], 4, [PX, PY, PZSH - 9], 17, "face wk-shade", "wk-mouth");

// The beam, from the shade's rim down to the desk. Built from the projected silhouette of each
// circle, so it is a real cone of light rather than a ribbon.
const N2 = 30;
const ringAt = (cz: number, r: number) =>
  Array.from({ length: N2 }, (_, i): V3 => {
    const a = (i / N2) * 2 * Math.PI;
    return [PX + r * Math.cos(a), PY + r * Math.sin(a), cz];
  });
const mouthPts = ringAt(PZSH - 9, 17);
const discPts = ringAt(Z + 0.3, 50);
function silhouette(pts: V3[]) {
  const pr = pts.map((q) => ({ q, s: P2(q) }));
  let a = 0, b = 0;
  pr.forEach((r, i) => { if (r.s[0] < pr[a].s[0]) a = i; if (r.s[0] > pr[b].s[0]) b = i; });
  return [pr[a].q, pr[b].q];
}
const [mL, mR] = silhouette(mouthPts);
const [dL, dR] = silhouette(discPts);
const throwPoly = [mL, mR, dR, dL];
// A hotspot where the beam actually lands. Without it the throw is one flat wash and reads as a
// shadow rather than as light: light has a brightest point, a shadow does not.
/* ⚠️ The pool is light lying ON THE DESK, so it goes under everything standing there. Inside the
   pendant's group it was drawn last and washed straight over the laptop, which is what made the
   whole middle of the picture look fogged. It sits on its own layer between the top and the
   things on it, and it does not swing: a pool's edge is soft enough that nobody misses it. */
push({
  p: Array.from({ length: 26 }, (_, i): V3 => {
    const a = (i / 26) * 2 * Math.PI;
    return [PX + 27 * Math.cos(a), PY + 27 * Math.sin(a), Z + 0.5];
  }),
  cls: "wk-pool", lay: 1.5,
});

// ---- mug: a cylinder, not a cube ----------------------------------------------------------------
/* A pot of pens rather than a mug. A mug at this size is a cylinder with a hook on it and reads
   as neither; pens give the object a silhouette that cannot be mistaken. */
const POT: V3 = [192, 26, Z], POTR = 9, POTH = 13;
cyl(POT[0], POT[1], POT[2], POTR, POTH);
/** A pen: a thin prism on a tilted axis, seated inside the pot. */
function pen(dx: number, dy: number, lift: number, cls: string) {
  const d: V3 = [dx, dy, lift];
  const e1 = norm(cross(d, [0, 0, 1] as V3));
  const e2 = norm(cross(d, e1));
  const t = 1.9;
  const base: V3 = [POT[0] + dx * -0.25, POT[1] + dy * -0.25, POT[2] + POTH - 5];
  prism(add(add(base, mul(e1, -t / 2)), mul(e2, -t / 2)), d, mul(e1, t), mul(e2, t), cls, 2);
}
pen(3.5, -1.5, 22, "face");
pen(-2.5, 3, 20, "wk-pen-hot");
pen(1, 4, 24, "face");
pen(-4, -2, 18, "face");


// ---- bins, clipboard ------------------------------------------------------------------------------
// ⚠️ These used to start at x = 12, which put the left one HALF OFF the desk: the top's left
// corner is at (0, DD) and a tray at y = 80 is already well down that edge. They sit inboard now.
// ⚠️ The trays and the laptop shared x 74..90 and y 74..90, so the laptop's near corner grew out
// of the right-hand tray. They are clear of each other now; check both boxes after moving either.
[0, 1].forEach((i) => {
  tray(16 + i * 32, 74, Z, 28, 28, 11, i === 1 ? "wk-fill hot" : "wk-fill");
});
const CX = 152, CY = 76, CW = 42, CD = 30;
pad(CX, CY, Z + 0.5, CW, CD, "wk-board");
bx(CX + CW / 2 - 7, CY + 2, Z + 0.5, 14, 6, 2.5);
const rules = [0.42, 0.58, 0.74].map((k) =>
  [[CX + 5, CY + CD * k, Z + 1.4], [CX + CW - 5, CY + CD * k, Z + 1.4]] as V3[]);

// ---- cull, sort, project --------------------------------------------------------------------------
const drawn = S.map((f) => {
  const n = f.n ?? cross(sub(f.p[1], f.p[0]), sub(f.p[2], f.p[0]));
  const c = f.p.reduce((a, p) => add(a, p), [0, 0, 0] as V3);
  return { f, vis: vdot(n) > 0, lay: f.lay ?? 2, key: vdot(c) / f.p.length + (f.bias ?? 0) };
})
  .filter((d) => d.vis)
  .sort((a, b) => (a.lay - b.lay) || (a.key - b.key))
  .map((d) => ({ cls: d.f.cls, lay: d.lay, pts: d.f.p.map((p) => P2(p).map((n) => n.toFixed(1)).join(",")).join(" ") }));
// The lid is outside the sorted set, because it MOVES and DOM order cannot. So the scene is
// emitted in two halves with the laptop between them: everything on the desk, then the laptop,
// then the lamp. Drawn after all of it, the lid painted straight over the lamp head.
const behind = drawn.filter((d) => d.lay < 4);
const infront = drawn.filter((d) => d.lay >= 4);
// The pendant's anchor in SCREEN space: the swing is a rotation about it.
const PIV = P2([PX, PY, PZTOP]);

const line = (p: V3[]) => p.map((v) => P2(v).map((n) => n.toFixed(1)).join(",")).join(" ");

// viewBox from real projected extents, so the object never sits in a corner of its own frame.
const every: V3[] = [...S.flatMap((f) => f.p), ...throwPoly, [LX, LY + LIDL * Math.cos(LIDOPEN), ZB + LIDL * Math.sin(LIDOPEN)], [LX + LW, LY, ZB + LIDL]];
const pj = every.map(P2);
const xs = pj.map((p) => p[0]), ys = pj.map((p) => p[1]);
const M = 12;
const vb = [Math.min(...xs) - M, Math.min(...ys) - M,
  Math.max(...xs) - Math.min(...xs) + M * 2, Math.max(...ys) - Math.min(...ys) + M * 2];

const lidCfg = JSON.stringify({ RX, RY, LX, LY, LW, ZB, LIDL, LIDOPEN });
---

<figure class="wk" data-wk data-lid={lidCfg} aria-hidden="true">
  <svg viewBox={vb.map((n) => n.toFixed(1)).join(" ")} role="presentation">
    {behind.map((d) => (<polygon class={d.cls} points={d.pts} />))}

    {/* The lid sits outside the sorted set: it moves, and DOM order cannot. Before the base is
        correct for the open state, which is where it rests. */}
    <polygon class="face wk-lid" points={lid0.lid} />
    {lid0.insets.map((pts, i) => (
      <polygon
        class={LID_INSETS[i].cls}
        points={pts}
        data-lk={[LID_INSETS[i].x0, LID_INSETS[i].x1, LID_INSETS[i].k0, LID_INSETS[i].k1].join(",")}
      />
    ))}

    {rules.map((r) => (<polyline class="wk-rule" points={line(r)} />))}

    {/* The pendant and its light swing as ONE unit, so they live in one rotated group. Light
        falls on everything, which is why it is painted last. */}
    <g class="wk-pend" data-piv={`${PIV[0].toFixed(1)},${PIV[1].toFixed(1)}`}>
      {/* ⚠️ The beam is drawn BEFORE the shade. After it, the light was painted over the lamp
          that emits it, so the shade looked lit from in front and half transparent. */}
      <polygon class="wk-throw" points={line(throwPoly)} />
      {infront.map((d) => (<polygon class={d.cls} points={d.pts} />))}
    </g>
  </svg>
</figure>

<style>
  .wk { margin: 0; display: block; }
  .wk svg { width: 100%; height: auto; display: block; overflow: visible; }

  .wk .wk-topslab.lit { fill: color-mix(in oklab, var(--face-hi) 84%, #cfe4ea); }
  .wk .wk-shade { fill: #8a6a3e; stroke: rgba(240, 196, 130, 0.4); }
  .wk .wk-cord { fill: #14262e; stroke: var(--edge-soft); }
  .wk .wk-mouth { fill: #f0c482; stroke: none; }

  .wk .wk-screen { fill: #17414c; stroke: var(--edge); stroke-width: 1;
    vector-effect: non-scaling-stroke; }
  .wk .wk-row { fill: rgba(160, 214, 214, 0.5); stroke: none; }
  .wk .wk-row.hot { fill: rgba(232, 132, 90, 0.85); }
  .wk .wk-keys { fill: #0d2029; stroke: var(--edge-soft); stroke-width: 1;
    vector-effect: non-scaling-stroke; }
  .wk .wk-pad { fill: #16303a; stroke: var(--edge-soft); stroke-width: 1;
    vector-effect: non-scaling-stroke; }
  .wk .wk-drawer { fill: #16323d; stroke: var(--edge-soft); stroke-width: 1;
    vector-effect: non-scaling-stroke; }
  .wk .wk-pull { fill: rgba(206, 222, 228, 0.55); stroke: none; }

  .wk .wk-board { fill: #20404e; stroke: rgba(214, 230, 236, 0.5); stroke-width: 1;
    vector-effect: non-scaling-stroke; }
  .wk .wk-rule { fill: none; stroke: rgba(206, 222, 228, 0.5); stroke-width: 1.4;
    vector-effect: non-scaling-stroke; }
  .wk .wk-fill { fill: #2f5f66; stroke: none; }
  .wk .wk-fill.hot { fill: var(--coral); }
  .wk .wk-handle { fill: none; stroke: var(--edge); stroke-width: 2.4; stroke-linejoin: round;
    stroke-linecap: round; vector-effect: non-scaling-stroke; }

  /* The beam itself is faint: at 0.14 it washed the monitors it passes and the whole desk read
     as fogged. The POOL is where light on a desk is actually visible, so that carries it. */
  .wk .wk-throw { fill: rgba(240, 196, 130, 0.055); stroke: none; opacity: 0; }
  .wk .wk-pool { fill: rgba(245, 206, 148, 0.13); stroke: none; }
  .wk .wk-pen-hot { fill: var(--coral); stroke: var(--edge); }
  .wk .wk-pen-hot.lit { fill: #f0a07a; }

  /* ---- motion. Gated on html[data-js], every rule in the group carrying the prefix, or a
     no-JS render shows an empty box (the [data-shot] trap, paid for once already). */
  :global(html[data-js]) .wk { opacity: 0; transform: translateY(12px); }
  :global(html[data-js]) .wk.in {
    opacity: 1; transform: none;
    transition: opacity 420ms var(--ease-out), transform 420ms var(--ease-out);
  }
  /* A lamp does not fade up, it strikes: two stutters, then steady. */
  :global(html[data-js]) .wk .wk-pool { opacity: 0; }
  :global(html[data-js]) .wk.in .wk-throw,
  :global(html[data-js]) .wk.in .wk-pool { animation: wkStrike 1100ms steps(1, end) 460ms forwards; }
  :global(html[data-js]) .wk.in .wk-mouth { animation: wkMouth 1100ms steps(1, end) 460ms forwards; }
  @keyframes wkStrike {
    0%, 18% { opacity: 0; } 22% { opacity: 1; } 30% { opacity: 0; }
    38% { opacity: 1; } 44% { opacity: 0.25; } 52%, 100% { opacity: 1; }
  }
  @keyframes wkMouth {
    0%, 18% { fill: #4a3c26; } 22% { fill: #f0c482; } 30% { fill: #4a3c26; }
    38% { fill: #f0c482; } 44% { fill: #9c7d4c; } 52%, 100% { fill: #f0c482; }
  }
  :global(html[data-js]) .wk .wk-row,
  :global(html[data-js]) .wk .wk-lidrow,
  :global(html[data-js]) .wk .wk-lidscreen { opacity: 0; }
  :global(html[data-js]) .wk.in .wk-row { opacity: 1; transition: opacity 500ms ease 1040ms; }
  :global(html[data-js]) .wk.in .wk-lidscreen,
  :global(html[data-js]) .wk.in .wk-lidrow { opacity: 1; transition: opacity 400ms ease 940ms; }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-js]) .wk { opacity: 1; transform: none; }
    :global(html[data-js]) .wk.in { transition: none; }
    :global(html[data-js]) .wk .wk-throw,
    :global(html[data-js]) .wk .wk-pool { opacity: 1; }
    :global(html[data-js]) .wk.in .wk-throw,
    :global(html[data-js]) .wk.in .wk-pool,
    :global(html[data-js]) .wk.in .wk-mouth { animation: none; }
    :global(html[data-js]) .wk .wk-row,
    :global(html[data-js]) .wk .wk-lidrow,
    :global(html[data-js]) .wk .wk-lidscreen { opacity: 1; }
    :global(html[data-js]) .wk.in .wk-row,
    :global(html[data-js]) .wk.in .wk-lidrow,
    :global(html[data-js]) .wk.in .wk-lidscreen { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var els = document.querySelectorAll("[data-wk]");
    if (!els.length) return;
    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // The lid is the one piece whose GEOMETRY changes, so it cannot be a CSS transform: a hinge
    // rotation in 3D is not a 2D rotation once projected. Its free edge is recomputed per frame
    // from the same constants the build used, handed over on the element.
    function lidOf(fig) {
      var cfg;
      try { cfg = JSON.parse(fig.getAttribute("data-lid")); } catch (e) { return null; }
      var lid = fig.querySelector(".wk-lid");
      var insets = fig.querySelectorAll("[data-lk]");
      if (!lid) return null;
      var RX = cfg.RX, RY = cfg.RY;
      function P(x, y, z) {
        return (x * RX[0] + y * RY[0]).toFixed(1) + "," + (x * RX[1] + y * RY[1] - z).toFixed(1);
      }
      function draw(t) {
        var dy = cfg.LIDL * Math.cos(t), dz = cfg.LIDL * Math.sin(t);
        var X = cfg.LX, Y = cfg.LY, W = cfg.LW, ZB = cfg.ZB;
        function q(x, k) { return P(X + x, Y + dy * k, ZB + dz * k); }
        lid.setAttribute("points", q(0, 0) + " " + q(W, 0) + " " + q(W, 1) + " " + q(0, 1));
        insets.forEach(function (el) {
          var d = el.getAttribute("data-lk").split(",").map(Number);   // x0, x1, k0, k1
          el.setAttribute("points",
            q(d[0], d[2]) + " " + q(d[1], d[2]) + " " + q(d[1], d[3]) + " " + q(d[0], d[3]));
        });
      }
      return { draw: draw, open: cfg.LIDOPEN };
    }

    /* ⚠️ The build renders the lid OPEN, which is the right no-JS state. So the CLOSED state has
       to be written here, at parse time, before the first paint. Setting it inside the observer
       instead means that on a page where the observer fires late the lid is seen open, snaps
       shut and then opens again. That is exactly what /ueber-uns did. */
    // The rig is stored ON the element. An index into the NodeList is one lookup away from
    // being -1, and when it is, the lid simply never animates and nothing reports it.
    els.forEach(function (el) {
      var r = lidOf(el);
      el._rig = r;
      if (r && !reduced) r.draw(0.02);
    });

    function animateLid(el) {
      var r = el._rig;
      if (!r) return;
      if (reduced) { r.draw(r.open); return; }
      var t0 = performance.now() + 280, DUR = 780;
      (function step(now) {
        var k = Math.min(1, Math.max(0, (now - t0) / DUR));
        var e = 1 - Math.pow(1 - k, 3);                    // ease-out, the site's only entrance
        r.draw(0.02 + (r.open - 0.02) * e);
        if (k < 1) requestAnimationFrame(step);
      })(performance.now());
    }

    /* The pendant sways. One sine against a slower one, so the motion never lands on an
       obvious beat, and an amplitude small enough that it reads as air moving rather than as a
       lamp being pushed. Reduced motion leaves it hanging still. */
    function sway(el) {
      if (reduced) return;
      var g = el.querySelector(".wk-pend");
      if (!g) return;
      var piv = (g.getAttribute("data-piv") || "0,0").split(",");
      var t0 = performance.now();
      (function step(now) {
        var t = (now - t0) / 1000;
        var a = 1.5 * Math.sin(t * 1.32) + 0.55 * Math.sin(t * 0.51 + 1.1);
        g.setAttribute("transform", "rotate(" + a.toFixed(3) + " " + piv[0] + " " + piv[1] + ")");
        requestAnimationFrame(step);
      })(performance.now());
    }

    function fire(el) { el.classList.add("in"); animateLid(el); sway(el); }

    if (!("IntersectionObserver" in window)) { els.forEach(fire); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        fire(en.target);
        io.unobserve(en.target);          // never re-runs on scroll back
      });
    }, { rootMargin: "0px 0px -12% 0px" });
    els.forEach(function (e) { io.observe(e); });
  })();
</script>
