---
import "@fontsource-variable/schibsted-grotesk";
import "../styles/global.css";
import { localePath, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** path without locale prefix, e.g. "/" or "/produkt" */
  path: string;
  /** set false for pages that exist in only one language */
  hasAlternate?: boolean;
  /** prototype surfaces: tracked and built, but must never be indexed */
  noindex?: boolean;
  /** a blog post: switches og:type and emits BlogPosting instead of the site-wide Organization */
  article?: { published: string; modified?: string; section?: string };
}
const { locale, title, description, path, hasAlternate = true, noindex = false, article } = Astro.props;

const site = "https://synapsio.solutions";
const canonical = site + localePath(locale, path);
const altDe = site + localePath("de", path);
const altEn = site + localePath("en", path);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {hasAlternate && <link rel="alternate" hreflang="de" href={altDe} />}
    {hasAlternate && <link rel="alternate" hreflang="en" href={altEn} />}
    {hasAlternate && <link rel="alternate" hreflang="x-default" href={altDe} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="Synapsio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-image.png`} />
    {/* Marks the document as scripted BEFORE first paint, so rules that hide something until JS
        can act on it (scroll reveals, the mobile menu button) never flash. It used to live at the
        end of /produkt only, which is both too late and too narrow. */}
    <script is:inline>document.documentElement.setAttribute("data-js", "1");</script>
    {/* ⚠️ STRUKTURIERTE DATEN. Ohne sie sieht eine Suchmaschine nur Fliesstext: sie weiss nicht,
        dass hinter der Seite ein Unternehmen mit Anschrift und Registereintrag steht, und bei
        einem Blogbeitrag nicht, wann er erschien und worum es geht. Beides ist bei einer neuen
        Domain ohne Backlinks der guenstigste Hebel, den es gibt. Die Angaben stammen aus dem
        Handelsregister und muessen mit dem Impressum uebereinstimmen. */}
    <script type="application/ld+json" set:html={JSON.stringify(article ? {
      "@context": "https://schema.org", "@type": "BlogPosting",
      headline: title, description, inLanguage: locale === "de" ? "de-DE" : "en",
      datePublished: article.published, dateModified: article.modified ?? article.published,
      articleSection: article.section, image: site + "/og-image.png",
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      publisher: { "@type": "Organization", name: "Synapsio", url: site,
                   logo: { "@type": "ImageObject", url: site + "/synapsio-logo.png" } },
    } : {
      "@context": "https://schema.org", "@type": "Organization",
      name: "Synapsio UG (haftungsbeschränkt)", alternateName: "Synapsio",
      url: site, logo: site + "/synapsio-logo.png", image: site + "/og-image.png",
      description,
      email: "contact@synapsio.co.site",
      sameAs: ["https://www.linkedin.com/company/synapsioai"],
      address: { "@type": "PostalAddress", streetAddress: "Berliner Allee 87 a",
                 postalCode: "14621", addressLocality: "Schönwalde-Glien", addressCountry: "DE" },
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
